  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useRef, useState } from \'react\';\nimport { Upload, Check, X, Pause, Play, Ban, Download, ShieldCheck } from \'lucide-react\';\nimport type { RoomInfo } from \'../../packages/protocol/src/index\';\nimport type { FileTransferItem } from \'../lib/termlinkWebClient\';\nimport { formatBytes } from \'../lib/browserUtils\';\n\ninterface FileTransferViewProps {\n  room: RoomInfo | null;\n  localPeerId: string;\n  transfers: FileTransferItem[];\n  onSendFile: (file: File, targetPeerId: string | \'group\') => void;\n  onAcceptFile: (transferId: string) => void;\n  onRejectFile: (transferId: string) => void;\n  onPauseFile: (transferId: string) => void;\n  onResumeFile: (transferId: string) => void;\n  onCancelFile: (transferId: string) => void;\n}\n\nexport const FileTransferView: React.FC<FileTransferViewProps> = ({\n  room,\n  localPeerId,\n  transfers,\n  onSendFile,\n  onAcceptFile,\n  onRejectFile,\n  onPauseFile,\n  onResumeFile,\n  onCancelFile,\n}) => {\n  const [target, setTarget] = useState<string>(\'group\');\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  if (!room) {\n    return (\n      <div className=\"max-w-3xl mx-auto rounded-lg border border-slate-800 bg-[#111827] p-8 text-center space-y-2\">\n        <h1 className=\"text-lg font-semibold text-white\">Connect to a room to transfer files</h1>\n        <p className=\"text-sm text-slate-400\">\n          Files stream directly between peers in verified SHA-256 chunks with explicit recipient approval.\n        </p>\n      </div>\n    );\n  }\n\n  const remoteMembers = room.members.filter((m) => m.peerId !== localPeerId);\n\n  const handleFileChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const files = e.target.files;\n    if (!files || files.length === 0) return;\n    for (let i = 0; i < files.length; i++) {\n      onSendFile(files[i], target === \'group\' ? \'group\' : target);\n    }\n    e.target.value = \'\';\n  };\n\n  const pendingIncoming = transfers.filter((t) => t.direction === \'receive\' && t.status === \'offering\');\n  const activeOrDone = transfers.filter((t) => !(t.direction === \'receive\' && t.status === \'offering\'));\n\n  return (\n    <div className=\"max-w-5xl mx-auto space-y-6\">\n      {/* Send File Section */}\n      <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6 space-y-4\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div>\n            <h1 className=\"text-xl font-semibold text-white\">Peer-to-Peer File Transfer</h1>\n            <p className=\"mt-1 text-xs text-slate-400\">\n              Chunked streaming with per-chunk and full-file SHA-256 verification. Recipients must explicitly accept every incoming transfer.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-3\">\n            <label htmlFor=\"file-target-select\" className=\"text-xs text-slate-400 whitespace-nowrap\">\n              Recipient\n            </label>\n            <select\n              id=\"file-target-select\"\n              value={target}\n              onChange={(e) => setTarget(e.target.value)}\n              className=\"rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-2 text-xs text-white focus:border-emerald-500 focus:outline-none\"\n            >\n              <option value=\"group\">Entire Group ({remoteMembers.length} peers)</option>\n              {remoteMembers.map((m) => (\n                <option key={m.peerId} value={m.peerId}>\n                  {m.identity.deviceName}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        <div className=\"rounded-md border border-dashed border-slate-700 bg-[#0B0F17] p-6 flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <div className=\"text-center sm:text-left\">\n            <p className=\"text-sm font-medium text-slate-200\">Select one or more files to transfer</p>\n            <p className=\"text-xs text-slate-400 mt-0.5\">\n              Never auto-executed \302\267 Never silently overwrites local files \302\267 Supports pause, resume, and cancel\n            </p>\n          </div>\n          <input\n            ref={fileInputRef}\n            type=\"file\"\n            multiple\n            onChange={handleFileChange}\n            className=\"hidden\"\n          />\n          <button\n            type=\"button\"\n            disabled={remoteMembers.length === 0}\n            onClick={() => fileInputRef.current?.click()}\n            className=\"inline-flex items-center gap-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 px-4 py-2.5 text-xs font-semibold text-white whitespace-nowrap\"\n          >\n            <Upload className=\"h-4 w-4\" />\n            Choose Files\n          </button>\n        </div>\n\n        {remoteMembers.length === 0 ? (\n          <p className=\"text-xs text-slate-500\">\n            Waiting for another peer to join room {room.code} before files can be transmitted.\n          </p>\n        ) : null}\n      </section>\n\n      {/* Incoming Transfer Offers */}\n      {pendingIncoming.length > 0 ? (\n        <section aria-label=\"Incoming file offers\" className=\"rounded-lg border border-amber-500/40 bg-[#111827] p-5 space-y-4\">\n          <h2 className=\"text-sm font-semibold text-amber-300\">Incoming File Offers ({pendingIncoming.length})</h2>\n          <div className=\"divide-y divide-slate-800\">\n            {pendingIncoming.map((offer) => (\n              <div key={offer.transferId} className=\"py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n                <div className=\"space-y-1\">\n                  <div className=\"text-sm font-medium text-white\">{offer.filename}</div>\n                  <div className=\"text-xs text-slate-400\">\n                    From {offer.peerName} \302\267 <span className=\"font-mono tabular-nums\">{formatBytes(offer.size)}</span> \302\267{\' \'}\n                    <span className=\"font-mono\">SHA-256 {offer.sha256.slice(0, 14)}...</span>\n                  </div>\n                </div>\n                <div className=\"flex items-center gap-2 shrink-0\">\n                  <button\n                    type=\"button\"\n                    onClick={() => onAcceptFile(offer.transferId)}\n                    className=\"inline-flex items-center gap-1.5 rounded-md bg-emerald-600 hover:bg-emerald-500 px-3.5 py-1.5 text-xs font-semibold text-white\"\n                  >\n                    <Check className=\"h-3.5 w-3.5\" /> Accept\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => onRejectFile(offer.transferId)}\n                    className=\"inline-flex items-center gap-1.5 rounded-md border border-slate-700 bg-slate-800 hover:bg-red-950/70 px-3.5 py-1.5 text-xs text-slate-200\"\n                  >\n                    <X className=\"h-3.5 w-3.5\" /> Decline\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        </section>\n      ) : null}\n\n      {/* Active & Historical Transfers */}\n      <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-5 space-y-4\">\n        <h2 className=\"text-base font-semibold text-white\">Transfers & Local History</h2>\n        {activeOrDone.length === 0 ? (\n          <p className=\"text-xs text-slate-500\">No file transfers yet in this session.</p>\n        ) : (\n          <div className=\"divide-y divide-slate-800\">\n            {activeOrDone.map((t) => (\n              <div key={t.transferId} className=\"py-4 space-y-2.5\">\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                  <div>\n                    <div className=\"text-sm font-medium text-white flex items-center gap-2\">\n                      <span>{t.filename}</span>\n                      <span className=\"text-xs font-normal text-slate-400\">\n                        {t.direction === \'send\' ? `\342\206\222 ${t.peerName}` : `\342\206\220 ${t.peerName}`}\n                      </span>\n                    </div>\n                    <div className=\"mt-0.5 text-xs text-slate-400 flex flex-wrap items-center gap-2 font-mono tabular-nums\">\n                      <span>\n                        {formatBytes(t.bytesTransferred)} / {formatBytes(t.size)}\n                      </span>\n                      <span aria-hidden=\"true\">\302\267</span>\n                      <span>\n                        {t.completedChunks}/{t.totalChunks} chunks\n                      </span>\n                      {t.status === \'transferring\' ? (\n                        <>\n                          <span aria-hidden=\"true\">\302\267</span>\n                          <span>{formatBytes(t.speedBytesPerSec)}/s</span>\n                          <span aria-hidden=\"true\">\302\267</span>\n                          <span>ETA {t.etaSeconds}s</span>\n                        </>\n                      ) : null}\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    {t.direction === \'send\' && t.status === \'transferring\' ? (\n                      <button\n                        type=\"button\"\n                        onClick={() => onPauseFile(t.transferId)}\n                        aria-label={`Pause ${t.filename}`}\n                        className=\"inline-flex items-center gap-1 rounded border border-slate-700 bg-slate-800 hover:bg-slate-700 px-2.5 py-1 text-xs text-slate-200\"\n                      >\n                        <Pause className=\"h-3.5 w-3.5\" /> Pause\n                      </button>\n                    ) : null}\n                    {t.direction === \'send\' && t.status === \'paused\' ? (\n                      <button\n                        type=\"button\"\n                        onClick={() => onResumeFile(t.transferId)}\n                        aria-label={`Resume ${t.filename}`}\n                        className=\"inline-flex items-center gap-1 rounded bg-emerald-600 hover:bg-emerald-500 px-2.5 py-1 text-xs text-white\"\n                      >\n                        <Play className=\"h-3.5 w-3.5\" /> Resume\n                      </button>\n                    ) : null}\n                    {(t.status === \'transferring\' || t.status === \'paused\' || t.status === \'offering\') ? (\n                      <button\n                        type=\"button\"\n                        onClick={() => onCancelFile(t.transferId)}\n                        aria-label={`Cancel ${t.filename}`}\n                        className=\"inline-flex items-center gap-1 rounded border border-slate-700 bg-slate-800 hover:bg-red-950/70 px-2.5 py-1 text-xs text-red-300\"\n                      >\n                        <Ban className=\"h-3.5 w-3.5\" /> Cancel\n                      </button>\n                    ) : null}\n                    {t.status === \'completed\' && t.downloadUrl ? (\n                      <a\n                        href={t.downloadUrl}\n                        download={t.filename}\n                        className=\"inline-flex items-center gap-1.5 rounded bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 text-xs font-semibold text-white\"\n                      >\n                        <Download className=\"h-3.5 w-3.5\" /> Save Verified File\n                      </a>\n                    ) : null}\n                  </div>\n                </div>\n\n                {/* Progress Bar */}\n                <div className=\"h-1.5 w-full rounded bg-slate-800 overflow-hidden\">\n                  <div\n                    className={`h-full transition-all duration-150 ${\n                      t.status === \'failed\' || t.status === \'rejected\' || t.status === \'cancelled\'\n                        ? \'bg-red-500\'\n                        : t.status === \'paused\'\n                          ? \'bg-amber-500\'\n                          : \'bg-emerald-500\'\n                    }`}\n                    style={{ width: `${t.percent}%` }}\n                  />\n                </div>\n\n                <div className=\"flex flex-wrap items-center justify-between text-[11px] text-slate-400\">\n                  <span className=\"capitalize\">\n                    Status: <strong className=\"text-slate-200\">{t.status}</strong>\n                    {t.error ? ` \342\200\224 ${t.error}` : \'\'}\n                  </span>\n                  {t.verified ? (\n                    <span className=\"inline-flex items-center gap-1 text-emerald-400 font-mono\">\n                      <ShieldCheck className=\"h-3.5 w-3.5\" />\n                      SHA-256 verified ({t.sha256.slice(0, 16)}...)\n                    </span>\n                  ) : (\n                    <span className=\"font-mono text-slate-500\">SHA-256: {t.sha256.slice(0, 16)}...</span>\n                  )}\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </section>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/FileTransferView.tsx"
        }
        overwrite: true
      }
    }
