              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            value={mode}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            onChange={(e) =>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                              onSetPeerAccess(m.peerId, m.identity.deviceName, m.role, e.target.value as TerminalAccessMode)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                            className=\"rounded border border-slate-700 bg-[#0B0F17] px-2 py-1 text-[11px] text-slate-100\""
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
