  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useRef, useEffect } from \'react\';\nimport { Terminal as TerminalIcon, Lock, Unlock, Power, ShieldAlert, Send } from \'lucide-react\';\nimport type { PeerRole, TerminalAccessMode } from \'../../packages/core/src/index\';\nimport type { RoomInfo } from \'../../packages/protocol/src/index\';\nimport type { TerminalAuditEntry, SharedTerminalSnapshot } from \'../../packages/terminal-session/src/index\';\n\ninterface TerminalShareViewProps {\n  room: RoomInfo | null;\n  localPeerId: string;\n  hostSession: SharedTerminalSnapshot | null;\n  remoteSession: {\n    sessionId: string;\n    sessionName: string;\n    ownerPeerId: string;\n    ownerName: string;\n    active: boolean;\n    locked: boolean;\n    shell: string;\n    permissions: Record<string, TerminalAccessMode>;\n  } | null;\n  terminalOutput: string;\n  onStartHostTerminal: (sessionName: string) => void;\n  onStopHostTerminal: () => void;\n  onToggleLock: (locked: boolean) => void;\n  onSetPeerAccess: (peerId: string, peerName: string, role: PeerRole, access: TerminalAccessMode) => void;\n  onSendInput: (commandLine: string) => void;\n  onClearOutput: () => void;\n}\n\nexport const TerminalShareView: React.FC<TerminalShareViewProps> = ({\n  room,\n  localPeerId,\n  hostSession,\n  remoteSession,\n  terminalOutput,\n  onStartHostTerminal,\n  onStopHostTerminal,\n  onToggleLock,\n  onSetPeerAccess,\n  onSendInput,\n  onClearOutput,\n}) => {\n  const [sessionName, setSessionName] = useState(\'backend-server\');\n  const [cmdInput, setCmdInput] = useState(\'\');\n  const outRef = useRef<HTMLPreElement>(null);\n\n  useEffect(() => {\n    if (outRef.current) {\n      outRef.current.scrollTop = outRef.current.scrollHeight;\n    }\n  }, [terminalOutput]);\n\n  if (!room) {\n    return (\n      <div className=\"max-w-3xl mx-auto rounded-lg border border-slate-800 bg-[#111827] p-8 text-center space-y-2\">\n        <h1 className=\"text-lg font-semibold text-white\">Join or create a room to share a terminal</h1>\n        <p className=\"text-sm text-slate-400\">\n          Remote terminal sharing is disabled by default and requires explicit host activation and per-peer permission grants.\n        </p>\n      </div>\n    );\n  }\n\n  const isOwner = room.ownerPeerId === localPeerId;\n  const activeSession = hostSession?.active ? hostSession : remoteSession?.active ? remoteSession : null;\n  const localAccess: TerminalAccessMode = isOwner\n    ? \'interactive\'\n    : activeSession?.permissions[localPeerId] || \'disabled\';\n  const canInteract = Boolean(\n    activeSession?.active && (isOwner || (!activeSession.locked && localAccess === \'interactive\'))\n  );\n\n  const handleCommandSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!cmdInput.trim() || !canInteract) return;\n    onSendInput(`${cmdInput}\\n`);\n    setCmdInput(\'\');\n  };\n\n  return (\n    <div className=\"max-w-5xl mx-auto space-y-6\">\n      {/* Header & Host Explicit Activation */}\n      <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6 space-y-4\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div>\n            <h1 className=\"text-xl font-semibold text-white\">Remote Terminal Sharing</h1>\n            <p className=\"mt-1 text-xs text-slate-400\">\n              Disabled by default. No background shell execution occurs unless the room host explicitly starts a session and grants access.\n            </p>\n          </div>\n\n          {isOwner && !hostSession?.active ? (\n            <div className=\"flex items-center gap-2\">\n              <input\n                type=\"text\"\n                aria-label=\"Terminal session name\"\n                value={sessionName}\n                onChange={(e) => setSessionName(e.target.value)}\n                placeholder=\"Session name\"\n                className=\"rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-2 text-xs text-white focus:border-emerald-500 focus:outline-none\"\n              />\n              <button\n                type=\"button\"\n                onClick={() => onStartHostTerminal(sessionName.trim() || \'host-shell\')}\n                className=\"inline-flex items-center gap-2 rounded-md bg-emerald-600 hover:bg-emerald-500 px-4 py-2 text-xs font-semibold text-white whitespace-nowrap\"\n              >\n                <TerminalIcon className=\"h-3.5 w-3.5\" />\n                Start Shared Terminal\n              </button>\n            </div>\n          ) : null}\n\n          {isOwner && hostSession?.active ? (\n            <div className=\"flex items-center gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => onToggleLock(!hostSession.locked)}\n                className=\"inline-flex items-center gap-1.5 rounded-md border border-slate-700 bg-slate-800 hover:bg-slate-700 px-3 py-2 text-xs font-medium text-slate-100 whitespace-nowrap\"\n              >\n                {hostSession.locked ? <Unlock className=\"h-3.5 w-3.5 text-amber-400\" /> : <Lock className=\"h-3.5 w-3.5\" />}\n                {hostSession.locked ? \'Unlock Input\' : \'Lock Input\'}\n              </button>\n              <button\n                type=\"button\"\n                onClick={onStopHostTerminal}\n                className=\"inline-flex items-center gap-1.5 rounded-md border border-red-900/70 bg-red-950/60 hover:bg-red-900/60 px-3 py-2 text-xs font-semibold text-red-200 whitespace-nowrap\"\n              >\n                <Power className=\"h-3.5 w-3.5\" />\n                Terminate Session\n              </button>\n            </div>\n          ) : null}\n        </div>\n\n        {!activeSession ? (\n          <div className=\"rounded-md border border-slate-800 bg-[#0B0F17] p-4 flex items-start gap-3 text-xs text-slate-300\">\n            <ShieldAlert className=\"h-4 w-4 text-emerald-400 shrink-0 mt-0.5\" />\n            <div>\n              <p className=\"font-medium text-slate-200\">No shared terminal session is active</p>\n              <p className=\"mt-1 text-slate-400\">\n                {isOwner\n                  ? \'Click \"Start Shared Terminal\" above to launch an isolated shell on this host. Connected peers default to Disabled until you grant Read-only or Interactive access.\'\n                  : \'Waiting for the room host to explicitly start a shared terminal session and grant you Read-only or Interactive access.\'}\n              </p>\n            </div>\n          </div>\n        ) : (\n          <div className=\"flex flex-wrap items-center gap-4 text-xs text-slate-400 pt-1 border-t border-slate-800\">\n            <span>\n              Session: <strong className=\"text-slate-100\">{activeSession.sessionName}</strong>\n            </span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>\n              Owner: <strong className=\"text-slate-100\">{activeSession.ownerName}</strong>\n            </span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>\n              Shell: <strong className=\"font-mono text-slate-100\">{activeSession.shell}</strong>\n            </span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>\n              Your Access: <strong className=\"capitalize text-emerald-400\">{localAccess}</strong>\n            </span>\n            {activeSession.locked ? (\n              <>\n                <span aria-hidden=\"true\">\302\267</span>\n                <span className=\"text-amber-400 font-medium\">Input Locked by Host</span>\n              </>\n            ) : null}\n          </div>\n        )}\n      </section>\n\n      {activeSession ? (\n        <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n          {/* Live Terminal Output + Authorized Input */}\n          <section className=\"lg:col-span-2 rounded-lg border border-slate-800 bg-[#070A10] flex flex-col h-[420px]\">\n            <div className=\"flex items-center justify-between px-4 py-2.5 border-b border-slate-800 bg-[#111827] rounded-t-lg text-xs\">\n              <span className=\"font-mono text-slate-200\">{activeSession.sessionName} ({activeSession.shell})</span>\n              <button type=\"button\" onClick={onClearOutput} className=\"text-slate-400 hover:text-white\">\n                Clear Output\n              </button>\n            </div>\n            <pre\n              ref={outRef}\n              data-testid=\"terminal-output-pane\"\n              className=\"flex-1 overflow-y-auto p-4 font-mono text-xs leading-relaxed text-emerald-200 whitespace-pre-wrap break-words\"\n            >\n              {terminalOutput || \'Shell ready. Type a command below (e.g. uname -a, pwd, ls, echo \"hello\")...\\n\'}\n            </pre>\n            <form onSubmit={handleCommandSubmit} className=\"p-3 border-t border-slate-800 bg-[#0D121C] flex items-center gap-2 rounded-b-lg\">\n              <span className=\"font-mono text-xs text-emerald-400 pl-1\">$</span>\n              <input\n                type=\"text\"\n                aria-label=\"Terminal command input\"\n                disabled={!canInteract}\n                value={cmdInput}\n                onChange={(e) => setCmdInput(e.target.value)}\n                placeholder={\n                  canInteract\n                    ? \'Enter shell command...\'\n                    : localAccess === \'read-only\'\n                      ? \'Read-only mode \342\200\224 interactive input disabled\'\n                      : \'Interactive input locked or not permitted\'\n                }\n                className=\"flex-1 bg-transparent font-mono text-xs text-white placeholder:text-slate-500 focus:outline-none disabled:opacity-50\"\n              />\n              <button\n                type=\"submit\"\n                disabled={!canInteract || !cmdInput.trim()}\n                className=\"inline-flex items-center gap-1 rounded bg-emerald-600 hover:bg-emerald-500 disabled:opacity-40 px-3 py-1.5 text-xs font-semibold text-white\"\n              >\n                <Send className=\"h-3 w-3\" /> Run\n              </button>\n            </form>\n          </section>\n\n          {/* Per-Peer Permission Matrix & Audit Trail */}\n          <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-5 flex flex-col space-y-5 h-[420px] overflow-y-auto\">\n            <div className=\"space-y-3\">\n              <h2 className=\"text-sm font-semibold text-white\">Peer Access Controls</h2>\n              <div className=\"divide-y divide-slate-800\">\n                {room.members\n                  .filter((m) => m.peerId !== activeSession.ownerPeerId)\n                  .map((m) => {\n                    const mode = activeSession.permissions[m.peerId] || \'disabled\';\n                    const disallowInteractive = m.role === \'guest\' || m.role === \'viewer\';\n                    return (\n                      <div key={m.peerId} className=\"py-2.5 flex items-center justify-between gap-2 text-xs\">\n                        <div className=\"min-w-0\">\n                          <div className=\"font-medium text-slate-200 truncate\">{m.identity.deviceName}</div>\n                          <div className=\"text-[11px] text-slate-400 capitalize\">{m.role}</div>\n                        </div>\n                        {isOwner ? (\n                          <select\n                            aria-label={`Terminal access for ${m.identity.deviceName}`}\n                            value={mode}\n                            onChange={(e) =>\n                              onSetPeerAccess(m.peerId, m.identity.deviceName, m.role, e.target.value as TerminalAccessMode)\n                            }\n                            className=\"rounded border border-slate-700 bg-[#0B0F17] px-2 py-1 text-[11px] text-slate-100\"\n                          >\n                            <option value=\"disabled\">Disabled</option>\n                            <option value=\"read-only\">Read-only</option>\n                            {!disallowInteractive ? <option value=\"interactive\">Interactive</option> : null}\n                          </select>\n                        ) : (\n                          <span className=\"text-[11px] capitalize text-slate-300\">{mode}</span>\n                        )}\n                      </div>\n                    );\n                  })}\n                {room.members.length <= 1 ? (\n                  <p className=\"text-xs text-slate-500 py-2\">No remote peers connected yet.</p>\n                ) : null}\n              </div>\n            </div>\n\n            {hostSession?.auditLog ? (\n              <div className=\"space-y-2 border-t border-slate-800 pt-4\">\n                <h3 className=\"text-xs font-semibold text-slate-300\">Session Audit Log</h3>\n                <ul className=\"space-y-1.5 font-mono text-[11px] text-slate-400\">\n                  {hostSession.auditLog\n                    .slice(-12)\n                    .reverse()\n                    .map((entry: TerminalAuditEntry, idx: number) => (\n                      <li key={`${entry.timestamp}-${idx}`} className=\"leading-snug\">\n                        <span className=\"text-slate-500\">\n                          {new Date(entry.timestamp).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\', second: \'2-digit\' })}\n                        </span>{\' \'}\n                        <span className={entry.event === \'input_rejected\' ? \'text-red-400\' : \'text-slate-200\'}>\n                          {entry.peerName}\n                        </span>\n                        : {entry.detail}\n                      </li>\n                    ))}\n                </ul>\n              </div>\n            ) : null}\n          </section>\n        </div>\n      ) : null}\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/TerminalShareView.tsx"
        }
        overwrite: true
      }
    }
