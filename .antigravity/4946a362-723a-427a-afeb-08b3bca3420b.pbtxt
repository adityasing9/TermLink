              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                {room.members"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  .filter((m) => m.peerId !== activeSession.ownerPeerId)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                  .map((m) => {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
