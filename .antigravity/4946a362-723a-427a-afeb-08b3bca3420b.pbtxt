              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    const disallowInteractive = m.role === \'guest\' || m.role === \'viewer\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                    return ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                      <div key={m.peerId} className=\"py-2.5 flex items-center justify-between gap-2 text-xs\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        <div className=\"min-w-0\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                          <div className=\"font-medium text-slate-200 truncate\">{m.identity.deviceName}</div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                          <div className=\"text-[11px] text-slate-400 capitalize\">{m.role}</div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "                        </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
