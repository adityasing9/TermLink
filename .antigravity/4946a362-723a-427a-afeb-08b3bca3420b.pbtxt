        instruction: "import React, { useEffect, useState, useCallback } from \'react\';\nimport { RefreshCw, AlertTriangle, CheckCircle2, Terminal } from \'lucide-react\';\nimport type { DiagnosticsReport } from \'../../packages/diagnostics/src/index\';\n\nexport const DiagnosticsView: React.FC = () => {\n  const [report, setReport] = useState<DiagnosticsReport | null>(null);\n  const [loading, setLoading] = useState(true);\n  const [detailed, setDetailed] = useState(false);\n  const [error, setError] = useState<string | null>(null);\n\n  const loadDiagnostics = useCallback(async (showDetailed: boolean) => {\n    setLoading(true);\n    setError(null);\n    try {\n      const res = await fetch(`/api/diagnostics?detailed=${showDetailed ? \'1\' : \'0\'}`);\n      if (!res.ok) throw new Error(`HTTP ${res.status}`);\n      const data = (await res.json()) as DiagnosticsReport;\n      setReport(data);\n    } catch (err) {\n      setError((err as Error).message);\n    } finally {\n      setLoading(false);\n    }\n  }, []);\n\n  useEffect(() => {\n    void loadDiagnostics(detailed);\n  }, [detailed, loadDiagnostics]);\n\n  return (\n    <div className=\"max-w-5xl mx-auto space-y-6\">\n      <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6 space-y-5\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div>\n            <h1 className=\"text-xl font-semibold text-white\">Network Diagnostics</h1>\n            <p className=\"mt-1 text-xs text-slate-400\">\n              Live server, signaling WebSocket, UDP STUN, direct socket listener, and relay fallback verification.\n            </p>\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <label className=\"flex items-center gap-2 text-xs text-slate-300 cursor-pointer whitespace-nowrap\">\n              <input\n                type=\"checkbox\"\n                checked={detailed}\n                onChange={(e) => setDetailed(e.target.checked)}\n                className=\"rounded border-slate-600 bg-[#0B0F17]\"\n              />\n              Show detailed IPs & ports\n            </label>\n            <button\n              type=\"button\"\n              onClick={() => void loadDiagnostics(detailed)}\n              disabled={loading}\n              className=\"inline-flex items-center gap-1.5 rounded-md border border-slate-700 bg-slate-800 hover:bg-slate-700 px-3 py-2 text-xs font-medium text-white whitespace-nowrap\"\n            >\n              <RefreshCw className={`h-3.5 w-3.5 ${loading ? \'animate-spin\' : \'\'}`} />\n              Re-run Checks\n            </button>\n          </div>\n        </div>\n\n        {error ? (\n          <div role=\"alert\" className=\"rounded-md border border-red-900/70 bg-red-950/50 p-4 text-xs text-red-200\">\n            Diagnostics failed: {error}\n          </div>\n        ) : null}\n\n        {loading && !report ? (\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n            {[1, 2, 3, 4].map((i) => (\n              <div key={i} className=\"h-20 rounded-md bg-slate-800/50 animate-pulse\" />\n            ))}\n          </div>\n        ) : report ? (\n          <>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n              <div className=\"rounded-md border border-slate-800 bg-[#0B0F17] p-4\">\n                <div className=\"text-xs text-slate-400\">Signaling Server</div>\n                <div className=\"mt-1.5 text-sm font-semibold text-white flex items-center gap-2\">\n                  <span className={report.signaling.connected ? \'text-emerald-400\' : \'text-red-400\'}>\n                    {report.signaling.connected ? \'Connected\' : \'Disconnected\'}\n                  </span>\n                  {report.signaling.rttMs !== undefined ? (\n                    <span className=\"font-mono text-xs text-slate-400 tabular-nums\">{report.signaling.rttMs} ms</span>\n                  ) : null}\n                </div>\n              </div>\n\n              <div className=\"rounded-md border border-slate-800 bg-[#0B0F17] p-4\">\n                <div className=\"text-xs text-slate-400\">STUN (NAT Traversal)</div>\n                <div className=\"mt-1.5 text-sm font-semibold\">\n                  <span className={report.stun.reachable ? \'text-emerald-400\' : \'text-amber-400\'}>\n                    {report.stun.reachable ? \'Successful\' : \'Restricted\'}\n                  </span>\n                </div>\n                <div className=\"mt-0.5 text-[11px] font-mono text-slate-500 truncate\">\n                  {report.stun.reachable\n                    ? `${report.stun.rttMs ?? 0} ms${detailed && report.stun.reflexiveIp ? ` \302\267 ${report.stun.reflexiveIp}:${report.stun.reflexivePort}` : \'\'}`\n                    : report.stun.error || \'UDP STUN blocked\'}\n                </div>\n              </div>\n\n              <div className=\"rounded-md border border-slate-800 bg-[#0B0F17] p-4\">\n                <div className=\"text-xs text-slate-400\">Direct P2P Listener</div>\n                <div className=\"mt-1.5 text-sm font-semibold\">\n                  <span className={report.directP2P.listenerAvailable ? \'text-emerald-400\' : \'text-amber-400\'}>\n                    {report.directP2P.listenerAvailable ? \'Available\' : \'Restricted\'}\n                  </span>\n                </div>\n                <div className=\"mt-0.5 text-[11px] font-mono text-slate-500\">\n                  {detailed && report.directP2P.ephemeralPort\n                    ? `Ephemeral TCP port ${report.directP2P.ephemeralPort}`\n                    : \'Direct TCP/WebRTC capable\'}\n                </div>\n              </div>\n\n              <div className=\"rounded-md border border-slate-800 bg-[#0B0F17] p-4\">\n                <div className=\"text-xs text-slate-400\">Relay Fallback</div>\n                <div className=\"mt-1.5 text-sm font-semibold\">\n                  <span className={report.relay.available ? \'text-emerald-400\' : \'text-red-400\'}>\n                    {report.relay.available ? \'Available\' : \'Unavailable\'}\n                  </span>\n                </div>\n                <div className=\"mt-0.5 text-[11px] text-slate-500\">\n                  {report.relay.mode === \'turn\' ? \'Configured TURN\' : \'E2EE Relay Fallback\'}\n                </div>\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t border-slate-800 text-xs\">\n              <dl className=\"space-y-2\">\n                <div className=\"flex justify-between\">\n                  <dt className=\"text-slate-400\">TermLink Version</dt>\n                  <dd className=\"font-mono text-slate-200\">v{report.termlinkVersion}</dd>\n                </div>\n                <div className=\"flex justify-between\">\n                  <dt className=\"text-slate-400\">Node.js Runtime</dt>\n                  <dd className=\"font-mono text-slate-200\">{report.nodeVersion}</dd>\n                </div>\n                <div className=\"flex justify-between\">\n                  <dt className=\"text-slate-400\">Host Platform</dt>\n                  <dd className=\"font-mono text-slate-200\">\n                    {report.platform} \302\267 {report.arch}\n                  </dd>\n                </div>\n                <div className=\"flex justify-between\">\n                  <dt className=\"text-slate-400\">Overall Readiness</dt>\n                  <dd className=\"inline-flex items-center gap-1 font-medium text-emerald-400\">\n                    <CheckCircle2 className=\"h-3.5 w-3.5\" /> {report.status}\n                  </dd>\n                </div>\n              </dl>\n\n              <div className=\"space-y-2\">\n                <div className=\"text-slate-400\">NAT & Network Advisory</div>\n                <p className=\"text-slate-200 leading-relaxed\">{report.natSummary}</p>\n                {report.firewallWarning ? (\n                  <div className=\"flex items-start gap-2 rounded bg-amber-950/40 border border-amber-900/60 p-2.5 text-amber-200\">\n                    <AlertTriangle className=\"h-4 w-4 shrink-0 mt-0.5 text-amber-400\" />\n                    <span>{report.firewallWarning}</span>\n                  </div>\n                ) : null}\n              </div>\n            </div>\n\n            {detailed && report.interfaces.length > 0 ? (\n              <div className=\"pt-3 border-t border-slate-800\">\n                <h2 className=\"text-xs font-semibold text-slate-300 mb-2\">Network Interfaces</h2>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-2 font-mono text-xs\">\n                  {report.interfaces.map((iface, idx) => (\n                    <div key={`${iface.name}-${idx}`} className=\"rounded bg-[#0B0F17] border border-slate-800 px-3 py-2\">\n                      <span className=\"text-slate-400\">{iface.name}:</span>{\' \'}\n                      <span className=\"text-slate-100\">{iface.address}</span>\n                    </div>\n                  ))}\n                </div>\n              </div>\n            ) : null}\n          </>\n        ) : null}\n      </section>\n\n      {/* Cross-Platform CLI & VM Guide */}\n      <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6 space-y-4\">\n        <div className=\"flex items-center gap-2\">\n          <Terminal className=\"h-4 w-4 text-emerald-400\" />\n          <h2 className=\"text-base font-semibold text-white\">CLI, SDK & Virtual Machine Quick Reference</h2>\n        </div>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4 text-xs\">\n          <div className=\"rounded-md border border-slate-800 bg-[#0B0F17] p-4 space-y-2\">\n            <h3 className=\"font-semibold text-slate-200\">CLI Commands (Windows, Linux, macOS, WSL2)</h3>\n            <pre className=\"font-mono text-emerald-300 overflow-x-auto leading-relaxed\">{`termlink                 # Interactive menu\ntermlink create          # Create room & get 2-digit code\ntermlink 47              # Quick-join room 47\ntermlink join <url>      # Join via invite link\ntermlink diagnostics     # Run network & STUN checks\ntermlink config set deviceName AADI-PC`}</pre>\n          </div>\n          <div className=\"rounded-md border border-slate-800 bg-[#0B0F17] p-4 space-y-2\">\n            <h3 className=\"font-semibold text-slate-200\">VMware & VirtualBox Networking</h3>\n            <ul className=\"space-y-1.5 text-slate-400 leading-relaxed\">\n              <li><strong className=\"text-slate-200\">Bridged:</strong> Direct LAN P2P between host & guests.</li>\n              <li><strong className=\"text-slate-200\">NAT:</strong> Uses STUN hole-punching or automatic E2EE relay fallback.</li>\n              <li><strong className=\"text-slate-200\">Host-only:</strong> Direct host-to-VM via local signaling server; no internet required.</li>\n            </ul>\n          </div>\n        </div>\n      </section>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/DiagnosticsView.tsx"
        }
        overwrite: true
      }
    }
