            lines {
              text: "## Core Features"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **2-Digit Quick Connect (`00`\342\200\223`99`)**: Dynamic discovery codes with host approval by default, sliding-window rate limiting, short TTL, code rotation, and safe multi-room collision disambiguation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Secure Invitation Links**: Configurable `/join/<code>` and cryptographically random `/invite/<token>` links with role scoping, expiration, one-time use, and revocation."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **End-to-End Encrypted Group Rooms**: Full mesh for 2\342\200\2238 peers (`N \303\227 (N - 1) / 2`) and selective hybrid topology for 9\342\200\22320 peers. Uses Ed25519 signing, X25519 key exchange, and AES-256-GCM encryption."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Real P2P Transport + Honest Relay Fallback**: Direct TCP P2P with RFC 5389 UDP STUN probing and opaque E2EE relay fallback. Accurately reports `Direct P2P`, `Local network`, `VPN`, `Relayed`, `Connecting`, or `Disconnected`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Chunked Streaming File Transfer**: Streaming I/O with 64 KiB chunks, per-chunk and full-file SHA-256 verification, backpressure, pause/resume/cancel, explicit recipient approval, path traversal protection, and conflict-free destination naming."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Opt-In Remote Terminal Sharing**: Disabled by default. Requires explicit host activation, per-peer `read-only` or `interactive` permissions, session locking, instant revocation, and local audit records."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Safe Command Proposals**: Send commands for peer review (`Accept` / `Edit` / `Reject`) with dangerous-command warnings (`rm -rf`, `curl | sh`, `mkfs`, `dd`). Never auto-executed."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "- **Role-Based Permissions**: `Owner`, `Admin`, `Collaborator`, `Viewer`, and `Guest`."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
