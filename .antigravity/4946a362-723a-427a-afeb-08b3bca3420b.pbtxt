  view_file {
    absolute_path_uri: "file:///package.json"
    end_line: 83
    content: "{\n  \"name\": \"termlink\",\n  \"version\": \"1.0.0\",\n  \"description\": \"Cross-platform P2P terminal collaboration platform \342\200\224 connect terminals, share files with SHA-256 verification, and collaborate directly.\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"keywords\": [\n    \"termlink\",\n    \"p2p\",\n    \"terminal\",\n    \"cli\",\n    \"collaboration\",\n    \"file-transfer\",\n    \"webrtc\",\n    \"e2ee\"\n  ],\n  \"engines\": {\n    \"node\": \">=20.0.0\"\n  },\n  \"bin\": {\n    \"termlink\": \"./dist/bin/termlink.mjs\",\n    \"termlink-server\": \"./dist/signaling-server.mjs\"\n  },\n  \"main\": \"./dist/sdk/index.mjs\",\n  \"types\": \"./dist/types/packages/sdk/src/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/types/packages/sdk/src/index.d.ts\",\n      \"import\": \"./dist/sdk/index.mjs\"\n    }\n  },\n  \"files\": [\n    \"dist\",\n    \"README.md\",\n    \"LICENSE\",\n    \"SECURITY.md\"\n  ],\n  \"workspaces\": [\n    \"apps/*\",\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"dev\": \"tsx server.ts\",\n    \"start\": \"node server.ts\",\n    \"build\": \"node scripts/build.mjs\",\n    \"cli\": \"node dist/bin/termlink.mjs\",\n    \"signaling\": \"node dist/signaling-server.mjs\",\n    \"test\": \"tsx --test tests/unit/*.test.ts tests/integration/*.test.ts tests/security/*.test.ts\",\n    \"test:unit\": \"tsx --test tests/unit/*.test.ts\",\n    \"test:integration\": \"tsx --test tests/integration/*.test.ts\",\n    \"test:security\": \"tsx --test tests/security/*.test.ts\",\n    \"pack:check\": \"npm pack --dry-run\",\n    \"clean\": \"rm -rf dist\",\n    \"lint\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@google/genai\": \"^2.4.0\",\n    \"@tailwindcss/vite\": \"^4.3.3\",\n    \"@types/ws\": \"^8.18.2\",\n    \"@vitejs/plugin-react\": \"^6.1.1\",\n    \"chalk\": \"^6.0.1\",\n    \"commander\": \"^15.1.0\",\n    \"dotenv\": \"^17.2.3\",\n    \"express\": \"^4.21.2\",\n    \"lucide-react\": \"^0.546.0\",\n    \"motion\": \"^12.23.24\",\n    \"react\": \"^19.0.1\",\n    \"react-dom\": \"^19.0.1\",\n    \"vite\": \"^8.3.0\",\n    \"ws\": \"^8.23.0\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^22.14.0\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"esbuild\": \"^0.25.0\",\n    \"tailwindcss\": \"^4.3.3\",\n    \"tsx\": \"^4.21.0\",\n    \"typescript\": \"^7.0.2\",\n    \"@types/express\": \"^4.17.21\"\n  }\n}\n"
    num_lines: 84
