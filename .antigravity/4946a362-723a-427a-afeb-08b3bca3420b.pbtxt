      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Ensure SharedTerminalSession.stop() closes stdin and escalates to SIGKILL so interactive bash shells terminate immediately on Linux/macOS\", \"EndLine\":205, \"Instruction\":\"Update stop() in packages/terminal-session/src/index.ts to end stdin and force-kill interactive shells cleanly\", \"ReplacementContent\":\"  stop(): void {\\n    if (!this.active || !this.proc) return;\\n    this.active = false;\\n    const proc = this.proc;\\n    this.proc = null;\\n    try {\\n      proc.stdin.end();\\n      proc.kill(\'SIGTERM\');\\n      // Interactive shells (e.g. bash -i) ignore SIGTERM on Unix; ensure immediate termination\\n      const killTimer = setTimeout(() => {\\n        if (proc.exitCode === null && !proc.killed) {\\n          try {\\n            proc.kill(\'SIGKILL\');\\n          } catch {\\n            // ignore\\n          }\\n        }\\n      }, 100);\\n      killTimer.unref?.();\\n      if (process.platform !== \'win32\') {\\n        proc.kill(\'SIGKILL\');\\n      }\\n    } catch {\\n      // ignore if already dead\\n    }\\n    this.recordAudit(\'session_stopped\', this.ownerPeerId, this.ownerName, \'Terminated by host\');\\n  }\", \"StartLine\":189, \"TargetContent\":\"  stop(): void {\\n    if (!this.active || !this.proc) return;\\n    this.active = false;\\n    try {\\n      this.proc.kill(\'SIGTERM\');\\n    } catch {\\n      // ignore if already dead\\n    }\\n    this.proc = null;\\n    this.recordAudit(\'session_stopped\', this.ownerPeerId, this.ownerName, \'Terminated by host\');\\n  }\", \"TargetFile\":\"/packages/terminal-session/src/index.ts\", \"toolAction\":\"Fixing interactive shell termination in terminal-session\", \"toolSummary\":\"Ensure immediate shell cleanup on stop()\"}"
