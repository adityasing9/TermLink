              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-5 flex flex-col space-y-5 h-[420px] overflow-y-auto\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <div className=\"space-y-3\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "              <h2 className=\"text-sm font-semibold text-white\">Peer Access Controls</h2>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
