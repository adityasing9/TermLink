            lines {
              text: "export function selectPeerAssistChunkSource("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  manifest: PeerAssistedManifest,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  chunkIndex: number,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
