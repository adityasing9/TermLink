      arguments_json: "{\"CodeContent\":\"{\\n  \\\"name\\\": \\\"@termlink/identity\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"main\\\": \\\"./src/index.ts\\\",\\n  \\\"types\\\": \\\"./src/index.ts\\\"\\n}\\n\", \"Description\":\"Create @termlink/identity package manifest\", \"Overwrite\":true, \"TargetFile\":\"/packages/identity/package.json\", \"toolAction\":\"Creating identity package manifest\", \"toolSummary\":\"Create identity package.json\"}"
      original_name: "write_to_file"
