  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Shield, RefreshCw, Download, UserCheck, UserMinus, Check } from \'lucide-react\';\nimport type { RoomInfo } from \'../../packages/protocol/src/index\';\nimport type { BrowserLocalIdentity, BrowserTrustedDevice } from \'../lib/browserCrypto\';\n\ninterface DevicesViewProps {\n  identity: BrowserLocalIdentity;\n  trustedDevices: BrowserTrustedDevice[];\n  room: RoomInfo | null;\n  localPeerId: string;\n  onRenameDevice: (newName: string) => void;\n  onResetIdentity: () => void;\n  onTrustPeer: (device: BrowserTrustedDevice) => void;\n  onRevokeDevice: (deviceId: string) => void;\n}\n\nexport const DevicesView: React.FC<DevicesViewProps> = ({\n  identity,\n  trustedDevices,\n  room,\n  localPeerId,\n  onRenameDevice,\n  onResetIdentity,\n  onTrustPeer,\n  onRevokeDevice,\n}) => {\n  const [nameInput, setNameInput] = useState(identity.publicIdentity.deviceName);\n  const [savedNotice, setSavedNotice] = useState(false);\n\n  const handleRename = (e: React.FormEvent) => {\n    e.preventDefault();\n    const cleaned = nameInput.trim();\n    if (!cleaned) return;\n    onRenameDevice(cleaned);\n    setSavedNotice(true);\n    window.setTimeout(() => setSavedNotice(false), 1800);\n  };\n\n  const handleExportPublic = () => {\n    const blob = new Blob([JSON.stringify(identity.publicIdentity, null, 2)], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement(\'a\');\n    a.href = url;\n    a.download = `termlink-public-identity-${identity.publicIdentity.deviceId.slice(0, 8)}.json`;\n    a.click();\n    URL.revokeObjectURL(url);\n  };\n\n  const remoteRoomPeers = room?.members.filter((m) => m.peerId !== localPeerId) || [];\n\n  return (\n    <div className=\"max-w-5xl mx-auto space-y-6\">\n      <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6 space-y-5\">\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-2.5\">\n            <Shield className=\"h-5 w-5 text-emerald-400\" />\n            <div>\n              <h1 className=\"text-xl font-semibold text-white\">Local Cryptographic Identity</h1>\n              <p className=\"text-xs text-slate-400\">\n                Private key material stays strictly on this device and is never transmitted to signaling servers or peers.\n              </p>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <button\n              type=\"button\"\n              onClick={handleExportPublic}\n              className=\"inline-flex items-center gap-1.5 rounded-md border border-slate-700 bg-slate-800 hover:bg-slate-700 px-3 py-2 text-xs font-medium text-slate-100 whitespace-nowrap\"\n            >\n              <Download className=\"h-3.5 w-3.5\" />\n              Export Public Key\n            </button>\n            <button\n              type=\"button\"\n              onClick={onResetIdentity}\n              className=\"inline-flex items-center gap-1.5 rounded-md border border-slate-700 bg-slate-800 hover:bg-red-950/70 hover:text-red-200 px-3 py-2 text-xs font-medium text-slate-200 whitespace-nowrap\"\n            >\n              <RefreshCw className=\"h-3.5 w-3.5\" />\n              Reset Identity\n            </button>\n          </div>\n        </div>\n\n        <form onSubmit={handleRename} className=\"grid grid-cols-1 md:grid-cols-2 gap-4 pt-2 border-t border-slate-800\">\n          <div>\n            <label htmlFor=\"device-name-input\" className=\"block text-xs font-medium text-slate-300 mb-1.5\">\n              Device Name\n            </label>\n            <div className=\"flex items-center gap-2\">\n              <input\n                id=\"device-name-input\"\n                type=\"text\"\n                maxLength={64}\n                value={nameInput}\n                onChange={(e) => setNameInput(e.target.value)}\n                className=\"flex-1 rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none\"\n              />\n              <button\n                type=\"submit\"\n                className=\"inline-flex items-center gap-1.5 rounded-md bg-emerald-600 hover:bg-emerald-500 px-3.5 py-2 text-xs font-semibold text-white whitespace-nowrap\"\n              >\n                {savedNotice ? <Check className=\"h-3.5 w-3.5\" /> : null}\n                {savedNotice ? \'Saved\' : \'Rename\'}\n              </button>\n            </div>\n          </div>\n\n          <div>\n            <div className=\"text-xs font-medium text-slate-300 mb-1.5\">Device Identifier & Platform</div>\n            <div className=\"rounded-md border border-slate-800 bg-[#0B0F17] px-3 py-2 text-xs font-mono text-slate-300\">\n              {identity.publicIdentity.deviceId} \302\267 {identity.publicIdentity.osDetail}\n            </div>\n          </div>\n\n          <div className=\"md:col-span-2\">\n            <div className=\"text-xs font-medium text-slate-300 mb-1.5\">Peer Fingerprint (SHA-256)</div>\n            <div className=\"rounded-md border border-slate-800 bg-[#0B0F17] px-3 py-2.5 font-mono text-xs text-emerald-300 break-all\">\n              {identity.publicIdentity.fingerprint}\n            </div>\n          </div>\n        </form>\n      </section>\n\n      {/* Connected Peers Verification */}\n      {remoteRoomPeers.length > 0 ? (\n        <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6 space-y-4\">\n          <h2 className=\"text-base font-semibold text-white\">Connected Room Peers</h2>\n          <div className=\"divide-y divide-slate-800\">\n            {remoteRoomPeers.map((m) => {\n              const existing = trustedDevices.find((d) => d.deviceId === m.identity.deviceId);\n              const isTrusted = existing?.status === \'trusted\';\n              return (\n                <div key={m.peerId} className=\"py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                  <div>\n                    <div className=\"text-sm font-medium text-white\">\n                      {m.identity.deviceName}{\' \'}\n                      <span className=\"text-xs font-normal text-slate-400\">({m.identity.platform})</span>\n                    </div>\n                    <div className=\"font-mono text-xs text-slate-400 mt-0.5 break-all\">\n                      {m.identity.fingerprint}\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    {isTrusted ? (\n                      <button\n                        type=\"button\"\n                        onClick={() => onRevokeDevice(m.identity.deviceId)}\n                        className=\"inline-flex items-center gap-1.5 rounded-md border border-slate-700 bg-slate-800 hover:bg-red-950/70 px-3 py-1.5 text-xs text-red-300\"\n                      >\n                        <UserMinus className=\"h-3.5 w-3.5\" /> Revoke Trust\n                      </button>\n                    ) : (\n                      <button\n                        type=\"button\"\n                        onClick={() =>\n                          onTrustPeer({\n                            deviceId: m.identity.deviceId,\n                            deviceName: m.identity.deviceName,\n                            platform: m.identity.platform,\n                            fingerprint: m.identity.fingerprint,\n                            signingPublicKey: m.identity.signingPublicKey,\n                            status: \'trusted\',\n                            updatedAt: Date.now(),\n                          })\n                        }\n                        className=\"inline-flex items-center gap-1.5 rounded-md bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 text-xs font-semibold text-white\"\n                      >\n                        <UserCheck className=\"h-3.5 w-3.5\" /> Trust Device\n                      </button>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </section>\n      ) : null}\n\n      {/* Trusted & Revoked Store */}\n      <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6 space-y-4\">\n        <h2 className=\"text-base font-semibold text-white\">Trusted & Revoked Devices</h2>\n        {trustedDevices.length === 0 ? (\n          <p className=\"text-xs text-slate-500\">\n            No trusted devices saved yet. Connect to a peer and verify their cryptographic fingerprint to add them.\n          </p>\n        ) : (\n          <div className=\"overflow-x-auto\">\n            <table className=\"w-full text-left text-xs\">\n              <thead>\n                <tr className=\"border-b border-slate-800 text-slate-400\">\n                  <th className=\"py-2 pr-4 font-medium\">Device</th>\n                  <th className=\"py-2 pr-4 font-medium\">Platform</th>\n                  <th className=\"py-2 pr-4 font-medium\">Fingerprint</th>\n                  <th className=\"py-2 pr-4 font-medium\">Status</th>\n                  <th className=\"py-2 text-right font-medium\">Action</th>\n                </tr>\n              </thead>\n              <tbody className=\"divide-y divide-slate-800/80\">\n                {trustedDevices.map((d) => (\n                  <tr key={d.deviceId}>\n                    <td className=\"py-2.5 pr-4 font-medium text-slate-100\">{d.deviceName}</td>\n                    <td className=\"py-2.5 pr-4 text-slate-400 capitalize\">{d.platform}</td>\n                    <td className=\"py-2.5 pr-4 font-mono text-slate-300\">{d.fingerprint.slice(0, 23)}...</td>\n                    <td className=\"py-2.5 pr-4\">\n                      <span className={d.status === \'trusted\' ? \'text-emerald-400\' : \'text-red-400\'}>\n                        {d.status === \'trusted\' ? \'Trusted\' : \'Revoked\'}\n                      </span>\n                    </td>\n                    <td className=\"py-2.5 text-right\">\n                      {d.status === \'trusted\' ? (\n                        <button\n                          type=\"button\"\n                          onClick={() => onRevokeDevice(d.deviceId)}\n                          className=\"text-red-400 hover:text-red-300\"\n                        >\n                          Revoke\n                        </button>\n                      ) : (\n                        <button\n                          type=\"button\"\n                          onClick={() => onTrustPeer({ ...d, status: \'trusted\', updatedAt: Date.now() })}\n                          className=\"text-emerald-400 hover:text-emerald-300\"\n                        >\n                          Restore\n                        </button>\n                      )}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n        )}\n      </section>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/DevicesView.tsx"
        }
        overwrite: true
      }
    }
    action_result {
