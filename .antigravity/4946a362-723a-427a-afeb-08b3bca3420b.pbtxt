  code_action {
    action_spec {
      create_file {
        instruction: "name: TermLink CI\n\non:\n  push:\n    branches: [main, release/*]\n  pull_request:\n    branches: [main]\n\njobs:\n  verify:\n    name: Test & Build (${{ matrix.os }} \302\267 Node ${{ matrix.node }})\n    runs-on: ${{ matrix.os }}\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, windows-latest, macos-latest]\n        node: [20, 22]\n\n    steps:\n      - name: Checkout repository\n        uses: actions/checkout@v4\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v4\n        with:\n          node-version: ${{ matrix.node }}\n          cache: npm\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Type check\n        run: npm run lint\n\n      - name: Run unit, integration, and security tests\n        run: npm test\n\n      - name: Build web companion\n        run: npm run build\n\n      - name: Validate npm package tarball\n        run: npm pack --dry-run\n"
        path {
          absolute_uri: "file:///.github/workflows/ci.yml"
        }
        overwrite: true
      }
    }
