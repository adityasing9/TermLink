    action_spec {
      create_file {
        instruction: "import chalk from \'chalk\';\nimport { formatBytes, formatConnectionMode, type RoomMember } from \'../../../packages/core/src/index\';\nimport type { RoomInfo } from \'../../../packages/protocol/src/index\';\n\nconst supportsUnicode =\n  process.platform !== \'win32\' ||\n  Boolean(process.env.WT_SESSION || process.env.TERM_PROGRAM === \'vscode\' || process.env.ConEmuTask);\n\nexport function renderBanner(subtitle: string = \'P2P COLLABORATION\'): string {\n  if (!supportsUnicode) {\n    return [\n      \'+============================================+\',\n      \'|                  TERMLINK                  |\',\n      `|              ${subtitle.padEnd(28)}  |`,\n      \'+============================================+\',\n    ].join(\'\\n\');\n  }\n  return [\n    chalk.cyan(\'\342\225\224\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\227\'),\n    chalk.cyan(\'\342\225\221\') + chalk.bold.white(\'                  TERMLINK                  \') + chalk.cyan(\'\342\225\221\'),\n    chalk.cyan(\'\342\225\221\') + chalk.gray(`             ${subtitle.padEnd(29)}  `) + chalk.cyan(\'\342\225\221\'),\n    chalk.cyan(\'\342\225\232\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\220\342\225\235\'),\n  ].join(\'\\n\');\n}\n\nexport function renderRoomCreated(room: RoomInfo): string {\n  const lines = [\n    \'\',\n    renderBanner(\'P2P COLLABORATION\'),\n    \'\',\n    chalk.green(\'Room created successfully!\'),\n    \'\',\n    chalk.dim(\'ROOM CODE\'),\n    \'\',\n    `                  ${chalk.bold.bgGreen.black(` ${room.code} `)}`,\n    \'\',\n    \'Join from another terminal:\',\n    \'\',\n    `    ${chalk.cyan(`termlink ${room.code}`)}`,\n    \'\',\n    \'Invite link:\',\n    \'\',\n    `    ${chalk.underline(room.joinUrl)}`,\n    \'\',\n    `Room: ${chalk.bold(room.roomName)} | Approval: ${room.requireHostApproval ? \'Required\' : \'Open\'}`,\n    `Status: ${room.members.length > 1 ? chalk.green(\'Connected\') : chalk.yellow(\'Waiting for peers...\')}`,\n    `Connected members: ${room.members.length}/${room.maxPeers}`,\n    \'\',\n  ];\n  return lines.join(\'\\n\');\n}\n\nexport function renderMemberList(room: RoomInfo): string {\n  const bullet = supportsUnicode ? \'\342\227\217\' : \'*\';\n  const rows = room.members.map((m: RoomMember) => {\n    const roleLabel = m.role === \'owner\' ? chalk.yellow(\'Host\') : chalk.white(m.role);\n    const modeLabel = chalk.dim(formatConnectionMode(m.connectionMode));\n    const nameCol = m.identity.deviceName.padEnd(18);\n    return `  ${chalk.green(bullet)} ${chalk.bold(nameCol)} ${roleLabel.padEnd(18)} ${modeLabel}`;\n  });\n  return [\n    \'\',\n    `Room: ${chalk.bold(room.roomName)}   Code: ${chalk.bold.cyan(room.code)}`,\n    `Connected peers: ${room.members.length}/${room.maxPeers}`,\n    \'\',\n    ...rows,\n    \'\',\n  ].join(\'\\n\');\n}\n\nexport function renderProgressBar(percent: number, width: number = 24): string {\n  const clamped = Math.max(0, Math.min(100, Math.round(percent)));\n  const filled = Math.round((clamped / 100) * width);\n  const fullChar = supportsUnicode ? \'\342\226\210\' : \'#\';\n  const emptyChar = supportsUnicode ? \'\342\226\221\' : \'-\';\n  return `[${chalk.green(fullChar.repeat(filled))}${chalk.dim(emptyChar.repeat(width - filled))}] ${String(clamped).padStart(3)}%`;\n}\n\nexport function renderFileOfferPrompt(offer: {\n  filename: string;\n  size: number;\n  senderName: string;\n  sha256: string;\n}): string {\n  return [\n    \'\',\n    chalk.bold.yellow(\'Incoming file\'),\n    `Filename: ${offer.filename}`,\n    `Size:     ${formatBytes(offer.size)}`,\n    `Sender:   ${offer.senderName}`,\n    `SHA-256:  ${offer.sha256.slice(0, 16)}...`,\n    \'\',\n  ].join(\'\\n\');\n}\n"
        path {
          absolute_uri: "file:///apps/cli/src/ui.ts"
        }
        overwrite: true
      }
    }
