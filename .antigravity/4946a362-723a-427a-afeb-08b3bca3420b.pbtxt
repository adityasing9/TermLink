      arguments_json: "{\"CodeContent\":\"{\\n  \\\"name\\\": \\\"@termlink/networking\\\",\\n  \\\"version\\\": \\\"1.0.0\\\",\\n  \\\"type\\\": \\\"module\\\",\\n  \\\"main\\\": \\\"./src/index.ts\\\",\\n  \\\"types\\\": \\\"./src/index.ts\\\"\\n}\\n\", \"Description\":\"Create @termlink/networking package manifest\", \"Overwrite\":true, \"TargetFile\":\"/packages/networking/package.json\", \"toolAction\":\"Creating networking package manifest\", \"toolSummary\":\"Create networking package.json\"}"
      original_name: "write_to_file"
