    tool_calls {
      id: "call_10249862757858302756"
      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Clear chunk ACK timers on acknowledgement and clear disconnect timeout on close so CLI processes exit immediately without lingering handles\", \"Instruction\":\"Update ackWaiters timer cleanup and disconnect timer cleanup in packages/sdk/src/index.ts\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":472, \"ReplacementContent\":\"            onChunk: async (chunkIndex, totalChunks, sha256, dataBase64) => {\\n              const ackKey = `${fromPeerId}:${chunkIndex}`;\\n              const ackPromise = new Promise<void>((resolve) => {\\n                const timer = setTimeout(() => {\\n                  if (active.ackWaiters.has(ackKey)) {\\n                    active.ackWaiters.delete(ackKey);\\n                    resolve();\\n                  }\\n                }, 15_000);\\n                timer.unref?.();\\n                active.ackWaiters.set(ackKey, () => {\\n                  clearTimeout(timer);\\n                  resolve();\\n                });\\n              });\\n\\n              this.transport.sendToPeer(fromPeerId, {\\n                kind: \'file:chunk\',\\n                transferId: payload.transferId,\\n                chunkIndex,\\n                totalChunks,\\n                sha256,\\n                dataBase64,\\n              });\\n              await ackPromise;\\n            },\", \"StartLine\":445, \"TargetContent\":\"            onChunk: async (chunkIndex, totalChunks, sha256, dataBase64) => {\\n              const ackKey = `${fromPeerId}:${chunkIndex}`;\\n              const ackPromise = new Promise<void>((resolve) => {\\n                active.ackWaiters.set(ackKey, resolve);\\n                // Safety timeout so broken peers cannot deadlock indefinitely\\n                setTimeout(() => {\\n                  if (active.ackWaiters.has(ackKey)) {\\n                    active.ackWaiters.delete(ackKey);\\n                    resolve();\\n                  }\\n                }, 15_000);\\n              });\\n\\n              this.transport.sendToPeer(fromPeerId, {\\n                kind: \'file:chunk\',\\n                transferId: payload.transferId,\\n                chunkIndex,\\n                totalChunks,\\n                sha256,\\n                dataBase64,\\n              });\\n              await ackPromise;\\n            },\"}, {\"AllowMultiple\":false, \"EndLine\":710, \"ReplacementContent\":\"      await new Promise<void>((resolve) => {\\n        if (ws.readyState === WebSocket.CLOSED) {\\n          resolve();\\n          return;\\n        }\\n        const timer = setTimeout(resolve, 500);\\n        timer.unref?.();\\n        ws.once(\'close\', () => {\\n          clearTimeout(timer);\\n          resolve();\\n        });\\n        ws.close();\\n      });\", \"StartLine\":690, \"TargetContent\":\"      await new Promise<void>((resolve) => {\\n        if (ws.readyState === WebSocket.CLOSED) {\\n          resolve();\\n          return;\\n        }\\n        ws.once(\'close\', () => resolve());\\n        ws.close();\\n        setTimeout(resolve, 500);\\n      });\"}], \"TargetFile\":\"/packages/sdk/src/index.ts\", \"toolAction\":\"Fixing lingering timer handles in SDK\", \"toolSummary\":\"Clear chunk ACK and disconnect timers\"}"
      original_name: "multi_replace_file_content"
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "bAIAa-zCGuaez7IPkb2O4Qs"
  }
