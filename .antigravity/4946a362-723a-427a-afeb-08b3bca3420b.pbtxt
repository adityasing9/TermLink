      thinking_signature: "\022\232\016\n\227\016\001i\024}\023\365\277\210\311\036P\327\t\303k,\271\\J\022.\335\"zO\026\026\3065h\340\344.\201R\345\031\tJu\206\231i(\033~\021$\364\262u\354\2747y\377\235\017O\331\247\353a\266\2027Bb\017zx\020v\266n\272h\274\272\311\270\320\200:\003\t\257\263\256)\230\277\251\031\272\244\034B\304\302_\252s\035\346\342%=\254\371%\201\333\342\351E\374X\332\303\334i\027\'/T\0219\037\201\325\320\025\345\322\356\026\000\303t\246\342\25064\265{\377\323\314\026\210\t{\344\2007\254\256\335\2401\315\r\224\227\'\351\2274\266\026\215\330\035\t\n\270\324\247nB\373#\000G\310\367\255n?\217P\374\347\\\321\244B\347\201G]C\220\301\302t\3103\'\376\320\002\362B\203\251\310\033\217\253\276Ez\247}K\314!\303\350\341k\323\362i\320\270\361\260\325\270\305q\240\v&\273\016\211\235t\322\250\031\024\217\276\023WY\220\350E9\002\2226\037(\277\233VW8CO\376XmL\016\265P\313\313\276\003\352-\336Q\377\303\355\264i&3\006\326U\317rctr\256,(:A=6S\2566\372\365Z0\017\267\025Z&an\257\263\206C\224\241\354X3b\032\301\242;WNE\201\321\342{\350h\311\022rJC/*tPn\243k\261\346\255\225R\n\305w\371\"u+\326\023XK\370V\351\260^\230v(\377\000Y\f\200XD\217\024\212q\216\306\260\v\003&E\251\237~4\a\257b\210\216d\302j|\001\002t\n\"\212#\321\303\2361\342\224\314\\n\023\'\0207\336j\251*h\344\272\362J\273\300\0335.Sa\203\347\313\027>\023\371\274D\001\261\262cn\3726\\\3465\037\223G\006O\024\207\237\272\306b\021\223h\266\364\261\324\262\000\254&R\020\365&&UI\031C\204\2127\334\244\237:\025\307q4N\236S\206\322\325\243=\343\336}\201\363\037\344\006\207\225\215\267=\301\314]\357=\310\334\344\267\213:[\021e\n;1\3145sA\376\332\331y\2239\324\004\313l\341\352\231U\031\275\375k\2074\234/\234\\u\336\0307\267B~O\273\330I\204\324\263E-c,~XW\035\345:4\257\347\272\026\004\344s\023X:\\\245S~\330\274[\255\031\330E\214O6&\212P\207\320|\305\365[\362\233I>\222F\323v\317\363\\>\336\203\"\335\033\350\020t\204\b\377`\316\347?\251\263\354q\204\264\325\31022\213\355\216\244L@p\340\371\001.4\303X3\200\240\304\315a\357\3310L}\304\341\306\306\022\221|\275)\323\262\360Mjf%n\234o\n\a\241\251\314\260\250\022V\305\276\327@\317VX\307\037\371_+\310\355j6\023+.\v\334E\374<v\363\355\206\241\224\304\351\005\354Z\246\030o\311\355\252u\373\204\307\303l;\2618\037\226H\257\302\177\222\3461*\205\377Lt\370\302\273\240\bF\246\336I\017\213\004\263\277\314\317\016\304\362\255\271\004\252r\350,\270p\370\036\aX2\b\307+\350\204\206\004\232\352E\360>\253(\vp{\220\3542~\205\333m\350\327\375\225\210\344\374\363>\033Kz?2\343\276\310\006f\224T\320\261\227h\362\232\v\024j\202\351\220\203tU\347\205\264\232\022IHh)\f\230\202\250\316\326W\322\017M:\254\277\035\307\250\200\320\276\365\032\240~\214\244)\216\351\324#N\030\026\360f.\215:\030\334\205\267\357\224\'~\370\207\360)w\340\315\302\350\200c\306B\351$\221\031\224d\243\2603\224y\200b\0249\344\3471\213\367\313\273\234\214\023\210\326\224lr\317\207\003\351\v\336\005j&\223\"#\2214`\273\355\0338\240v6f8\217\as\027\236WnI\227j~\000\220\346\030/\325Zrn\004\226\272\325\330_\027\227s\340)p\210\024\205f\203\373\277u\027\277\177xL\362\241#\000\201\341\270\337/<*\231)E\017\r\r\357Ex\346\316\336\r\211?B\251sq\371FH\aK\371\245\3138\271\323r\337\376\376]\ny\321\254j\201\2645\'\001W`\353\357\360J\210\243j\317S>\343\365]\204z\234\214\342\257\016P+\0363\323)\324N\342\377\311\262|\347z\005[{\346\337\213o8j\366\332{\033\005\f\245\245\r\374\235\2265az1\344\vXK\371*8%\367\004fMH\356\321\366\037\275\307\a\365\202VY\362\016g\232\276*\274\244\274m\3744u9\r\211\006j\337Ea\260u)\022{\3468:$\336\207\315\212\217\025WC\025\365d%\226\220ITg\326}\244\310[\214\206\230\273\255sYl\245L\225\263m\205#>\036\033\366\274eb\316L\367\230\355U\215\377\256\246\347\374a\202\260a]Q\327\237n\366\275\306\212\016\266%\230w,&@3\374\231\003\332\v\'\022\f\022\307\033\361\204\225\204\273GH5\322\243\250k\021\026\354\031Q\'D.\261\312K\206\222\004U\253\t4\336\036\316\304&\254uT\365\363\250\031\020\321\275\265\345<#2\363\361\024\203\"\022B\213\351\361\213\2265\203\370\177P\t\260\322\214\273\320\254ab\322\025d\033\3