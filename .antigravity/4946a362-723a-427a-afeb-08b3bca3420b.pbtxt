  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useEffect, useRef, useState, useCallback } from \'react\';\nimport type { ConnectionMode, PeerRole, TerminalAccessMode } from \'../packages/core/src/index\';\nimport type { InviteRecord, PendingJoinRequest, RoomCandidate, RoomInfo } from \'../packages/protocol/src/index\';\nimport type { SharedTerminalSnapshot } from \'../packages/terminal-session/src/index\';\nimport {\n  generateBrowserIdentity,\n  loadOrCreateBrowserIdentity,\n  loadTrustedDevices,\n  saveBrowserIdentity,\n  saveTrustedDevices,\n  type BrowserLocalIdentity,\n  type BrowserTrustedDevice,\n} from \'./lib/browserCrypto\';\nimport {\n  TermLinkWebClient,\n  type ChatItem,\n  type CommandProposalItem,\n  type FileTransferItem,\n} from \'./lib/termlinkWebClient\';\nimport { TopBar, type AppSection } from \'./components/TopBar\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { RoomView } from \'./components/RoomView\';\nimport { ChatView } from \'./components/ChatView\';\nimport { FileTransferView } from \'./components/FileTransferView\';\nimport { TerminalShareView } from \'./components/TerminalShareView\';\nimport { DevicesView } from \'./components/DevicesView\';\nimport { DiagnosticsView } from \'./components/DiagnosticsView\';\n\nfunction detectInitialPathJoin(): string {\n  const path = window.location.pathname;\n  const joinMatch = path.match(/^\\/join\\/([0-9]{2})$/);\n  if (joinMatch) return joinMatch[1];\n  const inviteMatch = path.match(/^\\/invite\\/([A-Za-z0-9_-]{16,128})$/);\n  if (inviteMatch) return window.location.href;\n  return \'\';\n}\n\nexport default function App() {\n  const [activeSection, setActiveSection] = useState<AppSection>(\'room\');\n  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);\n\n  const [identity, setIdentity] = useState<BrowserLocalIdentity | null>(null);\n  const [trustedDevices, setTrustedDevices] = useState<BrowserTrustedDevice[]>(() => loadTrustedDevices());\n\n  const [signalingConnected, setSignalingConnected] = useState(false);\n  const [localPeerId, setLocalPeerId] = useState(\'\');\n  const [room, setRoom] = useState<RoomInfo | null>(null);\n  const [peerModes, setPeerModes] = useState<Record<string, ConnectionMode>>({});\n  const [candidates, setCandidates] = useState<RoomCandidate[]>([]);\n  const [pendingJoin, setPendingJoin] = useState<{\n    roomId: string;\n    roomName: string;\n    hostName: string;\n    hostFingerprint: string;\n  } | null>(null);\n  const [joinRequests, setJoinRequests] = useState<PendingJoinRequest[]>([]);\n  const [invites, setInvites] = useState<InviteRecord[]>([]);\n\n  const [messages, setMessages] = useState<ChatItem[]>([]);\n  const [proposals, setProposals] = useState<CommandProposalItem[]>([]);\n  const [transfers, setTransfers] = useState<FileTransferItem[]>([]);\n\n  const [hostTerminal, setHostTerminal] = useState<SharedTerminalSnapshot | null>(null);\n  const [remoteTerminal, setRemoteTerminal] = useState<{\n    sessionId: string;\n    sessionName: string;\n    ownerPeerId: string;\n    ownerName: string;\n    active: boolean;\n    locked: boolean;\n    shell: string;\n    permissions: Record<string, TerminalAccessMode>;\n  } | null>(null);\n  const [terminalOutput, setTerminalOutput] = useState(\'\');\n  const lastTermSeqRef = useRef(0);\n\n  const [errorBanner, setErrorBanner] = useState<string | null>(null);\n  const [initialJoinInput] = useState<string>(() => detectInitialPathJoin());\n\n  const clientRef = useRef<TermLinkWebClient | null>(null);\n\n  useEffect(() => {\n    let active = true;\n    void loadOrCreateBrowserIdentity().then((id) => {\n      if (!active) return;\n      setIdentity(id);\n\n      const client = new TermLinkWebClient(id, {\n        onSignalingState: (connected, peerId) => {\n          setSignalingConnected(connected);\n          if (peerId) setLocalPeerId(peerId);\n        },\n        onRoomUpdated: (nextRoom) => {\n          setRoom(nextRoom);\n          if (!nextRoom) {\n            setJoinRequests([]);\n            setInvites([]);\n            setHostTerminal(null);\n            setRemoteTerminal(null);\n            setTerminalOutput(\'\');\n          }\n        },\n        onCandidates: (_code, list) => {\n          setCandidates(list);\n        },\n        onPendingJoin: (info) => {\n          setPendingJoin(info);\n        },\n        onJoinRequest: (req) => {\n          setJoinRequests((prev) => (prev.some((r) => r.requestId === req.requestId) ? prev : [...prev, req]));\n        },\n        onInviteCreated: (inv) => {\n          setInvites((prev) => [inv, ...prev]);\n        },\n        onInviteRevoked: (token) => {\n          setInvites((prev) => prev.map((i) => (i.token === token ? { ...i, revoked: true } : i)));\n        },\n        onChatMessage: (msg) => {\n          setMessages((prev) => (prev.some((m) => m.id === msg.id) ? prev : [...prev, msg]));\n        },\n        onMessageDelivered: (messageId) => {\n          setMessages((prev) => prev.map((m) => (m.id === messageId ? { ...m, delivered: true } : m)));\n        },\n        onCommandProposal: (item) => {\n          setProposals((prev) => [item, ...prev]);\n        },\n        onCommandDecision: (proposalId, decision, editedCommand) => {\n          setProposals((prev) =>\n            prev.map((p) => (p.proposalId === proposalId ? { ...p, status: decision, editedCommand } : p))\n          );\n        },\n        onFileTransferUpdate: (item) => {\n          setTransfers((prev) => {\n            const idx = prev.findIndex((t) => t.transferId === item.transferId);\n            if (idx === -1) return [item, ...prev];\n            const copy = [...prev];\n            copy[idx] = item;\n            return copy;\n          });\n        },\n        onPeerConnectionMode: (peerId, mode) => {\n          setPeerModes((prev) => ({ ...prev, [peerId]: mode }));\n        },\n        onRemoteTerminalState: (state) => {\n          setRemoteTerminal(state);\n        },\n        onRemoteTerminalOutput: (data) => {\n          setTerminalOutput((prev) => (prev + data).slice(-32000));\n        },\n        onError: (_code, message) => {\n          setErrorBanner(message);\n        },\n      });\n\n      clientRef.current = client;\n      client.connect();\n    });\n\n    return () => {\n      active = false;\n      clientRef.current?.disconnect();\n    };\n  }, []);\n\n  // Poll real host terminal output when the host has explicitly started a local shared shell\n  useEffect(() => {\n    if (!room || !hostTerminal?.active) return;\n    const interval = window.setInterval(async () => {\n      try {\n        const res = await fetch(\n          `/api/terminal/${encodeURIComponent(room.roomId)}?sinceSeq=${lastTermSeqRef.current}`\n        );\n        if (!res.ok) return;\n        const data = (await res.json()) as {\n          active: boolean;\n          snapshot: SharedTerminalSnapshot | null;\n          output: Array<{ seq: number; data: string }>;\n        };\n        if (data.snapshot) {\n          setHostTerminal(data.snapshot);\n        }\n        if (data.output && data.output.length > 0) {\n          let appended = \'\';\n          for (const chunk of data.output) {\n            if (chunk.seq > lastTermSeqRef.current) {\n              lastTermSeqRef.current = chunk.seq;\n              appended += chunk.data;\n              if (data.snapshot) {\n                void clientRef.current?.broadcastTerminalOutput(\n                  data.snapshot.sessionId,\n                  chunk.data,\n                  chunk.seq,\n                  data.snapshot.permissions\n                );\n              }\n            }\n          }\n          if (appended) {\n            setTerminalOutput((prev) => (prev + appended).slice(-32000));\n          }\n        }\n      } catch {\n        // ignore transient poll error\n      }\n    }, 350);\n\n    return () => window.clearInterval(interval);\n  }, [room, hostTerminal?.active]);\n\n  const handlePrimaryHeaderAction = useCallback(() => {\n    setErrorBanner(null);\n    if (room) {\n      clientRef.current?.leaveRoom();\n      setMessages([]);\n      setProposals([]);\n      setTransfers([]);\n      return;\n    }\n    if (!identity) return;\n    setActiveSection(\'room\');\n    clientRef.current?.createRoom({\n      roomName: `${identity.publicIdentity.deviceName} Room`,\n      requireHostApproval: true,\n      publicQuickConnect: true,\n      maxPeers: 8,\n    });\n  }, [room, identity]);\n\n  const handleStartHostTerminal = async (sessionName: string) => {\n    if (!room || !identity) return;\n    setErrorBanner(null);\n    lastTermSeqRef.current = 0;\n    setTerminalOutput(\'\');\n    try {\n      const res = await fetch(\'/api/terminal/start\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          roomId: room.roomId,\n          ownerPeerId: localPeerId,\n          ownerName: identity.publicIdentity.deviceName,\n          sessionName,\n        }),\n      });\n      const data = (await res.json()) as { snapshot?: SharedTerminalSnapshot; error?: string };\n      if (!res.ok || !data.snapshot) {\n        setErrorBanner(data.error || \'Could not start terminal session.\');\n        return;\n      }\n      setHostTerminal(data.snapshot);\n      await clientRef.current?.broadcastTerminalState({\n        sessionId: data.snapshot.sessionId,\n        sessionName: data.snapshot.sessionName,\n        ownerPeerId: data.snapshot.ownerPeerId,\n        ownerName: data.snapshot.ownerName,\n        active: data.snapshot.active,\n        locked: data.snapshot.locked,\n        shell: data.snapshot.shell,\n        permissions: data.snapshot.permissions,\n      });\n    } catch (err) {\n      setErrorBanner((err as Error).message);\n    }\n  };\n\n  const handleStopHostTerminal = async () => {\n    if (!room || !hostTerminal) return;\n    await fetch(`/api/terminal/${encodeURIComponent(room.roomId)}/stop`, {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ actorPeerId: localPeerId }),\n    });\n    const stopped = { ...hostTerminal, active: false };\n    setHostTerminal(null);\n    await clientRef.current?.broadcastTerminalState({\n      sessionId: stopped.sessionId,\n      sessionName: stopped.sessionName,\n      ownerPeerId: stopped.ownerPeerId,\n      ownerName: stopped.ownerName,\n      active: false,\n      locked: stopped.locked,\n      shell: stopped.shell,\n      permissions: stopped.permissions,\n    });\n  };\n\n  const handleToggleLockTerminal = async (locked: boolean) => {\n    if (!room) return;\n    const res = await fetch(`/api/terminal/${encodeURIComponent(room.roomId)}/lock`, {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ actorPeerId: localPeerId, locked }),\n    });\n    const data = (await res.json()) as { snapshot?: SharedTerminalSnapshot };\n    if (data.snapshot) {\n      setHostTerminal(data.snapshot);\n      await clientRef.current?.broadcastTerminalState({\n        sessionId: data.snapshot.sessionId,\n        sessionName: data.snapshot.sessionName,\n        ownerPeerId: data.snapshot.ownerPeerId,\n        ownerName: data.snapshot.ownerName,\n        active: data.snapshot.active,\n        locked: data.snapshot.locked,\n        shell: data.snapshot.shell,\n        permissions: data.snapshot.permissions,\n      });\n    }\n  };\n\n  const handleSetTerminalPeerAccess = async (\n    targetPeerId: string,\n    targetName: string,\n    targetRole: PeerRole,\n    access: TerminalAccessMode\n  ) => {\n    if (!room) return;\n    const res = await fetch(`/api/terminal/${encodeURIComponent(room.roomId)}/permission`, {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        actorPeerId: localPeerId,\n        targetPeerId,\n        targetName,\n        targetRole,\n        access,\n      }),\n    });\n    const data = (await res.json()) as { snapshot?: SharedTerminalSnapshot; error?: string };\n    if (!res.ok) {\n      setErrorBanner(data.error || \'Permission update failed.\');\n      return;\n    }\n    if (data.snapshot) {\n      setHostTerminal(data.snapshot);\n      clientRef.current?.setTerminalAccess(targetPeerId, access);\n      await clientRef.current?.broadcastTerminalState({\n        sessionId: data.snapshot.sessionId,\n        sessionName: data.snapshot.sessionName,\n        ownerPeerId: data.snapshot.ownerPeerId,\n        ownerName: data.snapshot.ownerName,\n        active: data.snapshot.active,\n        locked: data.snapshot.locked,\n        shell: data.snapshot.shell,\n        permissions: data.snapshot.permissions,\n      });\n    }\n  };\n\n  const handleSendTerminalInput = async (data: string) => {\n    if (!room || !identity) return;\n    if (hostTerminal?.active) {\n      const res = await fetch(`/api/terminal/${encodeURIComponent(room.roomId)}/input`, {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          peerId: localPeerId,\n          peerName: identity.publicIdentity.deviceName,\n          data,\n        }),\n      });\n      if (!res.ok) {\n        const err = (await res.json()) as { error?: string };\n        setErrorBanner(err.error || \'Input rejected.\');\n      }\n      return;\n    }\n    if (remoteTerminal?.active) {\n      await clientRef.current?.sendRemoteTerminalInput(remoteTerminal.ownerPeerId, remoteTerminal.sessionId, data);\n    }\n  };\n\n  const handleRenameDevice = (newName: string) => {\n    if (!identity) return;\n    const updated: BrowserLocalIdentity = {\n      ...identity,\n      publicIdentity: { ...identity.publicIdentity, deviceName: newName },\n    };\n    setIdentity(updated);\n    saveBrowserIdentity(updated);\n    clientRef.current?.updateIdentity(updated);\n  };\n\n  const handleResetIdentity = async () => {\n    const fresh = await generateBrowserIdentity(identity?.publicIdentity.deviceName);\n    setIdentity(fresh);\n    saveBrowserIdentity(fresh);\n    clientRef.current?.updateIdentity(fresh);\n  };\n\n  const handleTrustPeer = (device: BrowserTrustedDevice) => {\n    setTrustedDevices((prev) => {\n      const next = [...prev.filter((d) => d.deviceId !== device.deviceId), device];\n      saveTrustedDevices(next);\n      return next;\n    });\n  };\n\n  const handleRevokeDevice = (deviceId: string) => {\n    setTrustedDevices((prev) => {\n      const next = prev.map((d) =>\n        d.deviceId === deviceId ? { ...d, status: \'revoked\' as const, updatedAt: Date.now() } : d\n      );\n      saveTrustedDevices(next);\n      return next;\n    });\n  };\n\n  if (!identity) {\n    return (\n      <div className=\"min-h-screen bg-[#0B0F17] flex items-center justify-center text-sm text-slate-400\">\n        Initializing cryptographic identity...\n      </div>\n    );\n  }\n\n  const pendingFileCount = transfers.filter((t) => t.direction === \'receive\' && t.status === \'offering\').length;\n\n  return (\n    <div className=\"min-h-screen bg-[#0B0F17] text-[#E6EDF3] flex flex-col\">\n      <TopBar\n        activeSection={activeSection}\n        onSelectSection={setActiveSection}\n        inRoom={Boolean(room)}\n        onPrimaryAction={handlePrimaryHeaderAction}\n        mobileMenuOpen={mobileMenuOpen}\n        onToggleMobileMenu={() => setMobileMenuOpen((v) => !v)}\n      />\n\n      <div className=\"flex flex-1 min-h-0\">\n        <Sidebar\n          activeSection={activeSection}\n          onSelectSection={setActiveSection}\n          signalingConnected={signalingConnected}\n          localPeerId={localPeerId}\n          localDeviceName={identity.publicIdentity.deviceName}\n          localFingerprint={identity.publicIdentity.fingerprint}\n          room={room}\n          peerModes={peerModes}\n          pendingApprovalCount={joinRequests.length}\n          pendingFileCount={pendingFileCount}\n          onKickPeer={(pid) => clientRef.current?.kickPeer(pid)}\n          onSetRole={(pid, role) => clientRef.current?.setPeerRole(pid, role)}\n          mobileOpen={mobileMenuOpen}\n          onCloseMobile={() => setMobileMenuOpen(false)}\n        />\n\n        <main className=\"flex-1 min-w-0 p-5 md:p-8 overflow-y-auto\">\n          {errorBanner ? (\n            <div\n              role=\"alert\"\n              className=\"max-w-5xl mx-auto mb-5 rounded-md border border-red-900/70 bg-red-950/50 px-4 py-3 flex items-center justify-between gap-4 text-xs text-red-200\"\n            >\n              <span>{errorBanner}</span>\n              <button\n                type=\"button\"\n                onClick={() => setErrorBanner(null)}\n                className=\"text-red-300 hover:text-white whitespace-nowrap\"\n              >\n                Dismiss\n              </button>\n            </div>\n          ) : null}\n\n          {activeSection === \'room\' ? (\n            <RoomView\n              signalingConnected={signalingConnected}\n              localPeerId={localPeerId}\n              localDeviceName={identity.publicIdentity.deviceName}\n              room={room}\n              pendingJoin={pendingJoin}\n              candidates={candidates}\n              joinRequests={joinRequests}\n              invites={invites}\n              initialJoinInput={initialJoinInput}\n              onCreateRoom={(opts) => {\n                setErrorBanner(null);\n                clientRef.current?.createRoom(opts);\n              }}\n              onJoinCode={(code, password) => {\n                setErrorBanner(null);\n                clientRef.current?.joinByCode(code, password);\n              }}\n              onJoinRoomId={(roomId, password) => {\n                setErrorBanner(null);\n                setCandidates([]);\n                clientRef.current?.joinByRoomId(roomId, password);\n              }}\n              onJoinInvite={(token) => {\n                setErrorBanner(null);\n                clientRef.current?.joinByInvite(token);\n              }}\n              onApproveJoin={(reqId, role) => {\n                clientRef.current?.approveJoin(reqId, role);\n                setJoinRequests((prev) => prev.filter((r) => r.requestId !== reqId));\n              }}\n              onRejectJoin={(reqId) => {\n                clientRef.current?.rejectJoin(reqId);\n                setJoinRequests((prev) => prev.filter((r) => r.requestId !== reqId));\n              }}\n              onRotateCode={() => clientRef.current?.rotateCode()}\n              onCreateInvite={(opts) => clientRef.current?.createInvite(opts)}\n              onRevokeInvite={(token) => clientRef.current?.revokeInvite(token)}\n              onUpdateSettings={(s) => clientRef.current?.updateRoomSettings(s)}\n              onCloseRoom={() => clientRef.current?.closeRoom()}\n              onClearCandidates={() => setCandidates([])}\n            />\n          ) : null}\n\n          {activeSection === \'chat\' ? (\n            <ChatView\n              room={room}\n              localPeerId={localPeerId}\n              messages={messages}\n              proposals={proposals}\n              onSendGroupMessage={(text) => void clientRef.current?.sendGroupMessage(text)}\n              onSendPrivateMessage={(pid, text) => void clientRef.current?.sendPrivateMessage(pid, text)}\n              onClearChat={() => setMessages([])}\n              onLeaveRoom={() => clientRef.current?.leaveRoom()}\n              onProposeCommand={(pid, cmd, desc) => void clientRef.current?.proposeCommand(pid, cmd, desc)}\n              onRespondProposal={(id, pid, dec, edited) =>\n                void clientRef.current?.respondCommandProposal(id, pid, dec, edited)\n              }\n            />\n          ) : null}\n\n          {activeSection === \'files\' ? (\n            <FileTransferView\n              room={room}\n              localPeerId={localPeerId}\n              transfers={transfers}\n              onSendFile={(file, target) => void clientRef.current?.sendFile(file, target)}\n              onAcceptFile={(tid) => void clientRef.current?.acceptIncomingFile(tid)}\n              onRejectFile={(tid) => void clientRef.current?.rejectIncomingFile(tid)}\n              onPauseFile={(tid) => clientRef.current?.pauseTransfer(tid)}\n              onResumeFile={(tid) => clientRef.current?.resumeTransfer(tid)}\n              onCancelFile={(tid) => clientRef.current?.cancelTransfer(tid)}\n            />\n          ) : null}\n\n          {activeSection === \'terminal\' ? (\n            <TerminalShareView\n              room={room}\n              localPeerId={localPeerId}\n              hostSession={hostTerminal}\n              remoteSession={remoteTerminal}\n              terminalOutput={terminalOutput}\n              onStartHostTerminal={(name) => void handleStartHostTerminal(name)}\n              onStopHostTerminal={() => void handleStopHostTerminal()}\n              onToggleLock={(locked) => void handleToggleLockTerminal(locked)}\n              onSetPeerAccess={(pid, name, role, acc) => void handleSetTerminalPeerAccess(pid, name, role, acc)}\n              onSendInput={(cmd) => void handleSendTerminalInput(cmd)}\n              onClearOutput={() => setTerminalOutput(\'\')}\n            />\n          ) : null}\n\n          {activeSection === \'devices\' ? (\n            <DevicesView\n              identity={identity}\n              trustedDevices={trustedDevices}\n              room={room}\n              localPeerId={localPeerId}\n              onRenameDevice={handleRenameDevice}\n              onResetIdentity={() => void handleResetIdentity()}\n              onTrustPeer={handleTrustPeer}\n              onRevokeDevice={handleRevokeDevice}\n            />\n          ) : null}\n\n          {activeSection === \'diagnostics\' ? <DiagnosticsView /> : null}\n        </main>\n      </div>\n    </div>\n  );\n}\n"
