  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState } from \'react\';\nimport { Copy, Check, RefreshCw, Link2, ShieldCheck, KeyRound, Trash2, ArrowRight } from \'lucide-react\';\nimport type { PeerRole } from \'../../packages/core/src/index\';\nimport type { InviteRecord, PendingJoinRequest, RoomCandidate, RoomInfo } from \'../../packages/protocol/src/index\';\nimport { parseJoinInput } from \'../lib/browserUtils\';\n\ninterface RoomViewProps {\n  signalingConnected: boolean;\n  localPeerId: string;\n  localDeviceName: string;\n  room: RoomInfo | null;\n  pendingJoin: { roomId: string; roomName: string; hostName: string; hostFingerprint: string } | null;\n  candidates: RoomCandidate[];\n  joinRequests: PendingJoinRequest[];\n  invites: InviteRecord[];\n  initialJoinInput?: string;\n  onCreateRoom: (opts: {\n    roomName: string;\n    requireHostApproval: boolean;\n    publicQuickConnect: boolean;\n    password?: string;\n    maxPeers: number;\n  }) => void;\n  onJoinCode: (code: string, password?: string) => void;\n  onJoinRoomId: (roomId: string, password?: string) => void;\n  onJoinInvite: (token: string) => void;\n  onApproveJoin: (requestId: string, role: PeerRole) => void;\n  onRejectJoin: (requestId: string) => void;\n  onRotateCode: () => void;\n  onCreateInvite: (opts: { role: PeerRole; oneTime: boolean; expiresInMs: number }) => void;\n  onRevokeInvite: (token: string) => void;\n  onUpdateSettings: (settings: { publicQuickConnect?: boolean; requireHostApproval?: boolean; password?: string | null }) => void;\n  onCloseRoom: () => void;\n  onClearCandidates: () => void;\n}\n\nexport const RoomView: React.FC<RoomViewProps> = ({\n  signalingConnected,\n  localPeerId,\n  localDeviceName,\n  room,\n  pendingJoin,\n  candidates,\n  joinRequests,\n  invites,\n  initialJoinInput = \'\',\n  onCreateRoom,\n  onJoinCode,\n  onJoinRoomId,\n  onJoinInvite,\n  onApproveJoin,\n  onRejectJoin,\n  onRotateCode,\n  onCreateInvite,\n  onRevokeInvite,\n  onUpdateSettings,\n  onCloseRoom,\n  onClearCandidates,\n}) => {\n  const [roomName, setRoomName] = useState(`${localDeviceName} Room`);\n  const [requireApproval, setRequireApproval] = useState(true);\n  const [publicQuickConnect, setPublicQuickConnect] = useState(true);\n  const [createPassword, setCreatePassword] = useState(\'\');\n  const [maxPeers, setMaxPeers] = useState(8);\n\n  const [joinInput, setJoinInput] = useState(initialJoinInput);\n  const [joinPassword, setJoinPassword] = useState(\'\');\n  const [joinValidationError, setJoinValidationError] = useState<string | null>(null);\n\n  const [copiedKey, setCopiedKey] = useState<string | null>(null);\n  const [inviteRole, setInviteRole] = useState<PeerRole>(\'collaborator\');\n  const [inviteOneTime, setInviteOneTime] = useState(false);\n  const [inviteTtlMin, setInviteTtlMin] = useState(60);\n  const [approvalRoles, setApprovalRoles] = useState<Record<string, PeerRole>>({});\n\n  const copyText = async (key: string, value: string) => {\n    try {\n      await navigator.clipboard.writeText(value);\n      setCopiedKey(key);\n      window.setTimeout(() => setCopiedKey(null), 1800);\n    } catch {\n      // Clipboard API may be unavailable in non-HTTPS contexts\n    }\n  };\n\n  const handleJoinSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    const parsed = parseJoinInput(joinInput);\n    if (parsed.kind === \'invalid\') {\n      setJoinValidationError(parsed.reason);\n      return;\n    }\n    setJoinValidationError(null);\n    if (parsed.kind === \'code\') {\n      onJoinCode(parsed.code, joinPassword || undefined);\n    } else {\n      onJoinInvite(parsed.token);\n    }\n  };\n\n  const isOwner = room?.ownerPeerId === localPeerId;\n  const localMember = room?.members.find((m) => m.peerId === localPeerId);\n  const canInvite = localMember?.role === \'owner\' || localMember?.role === \'admin\';\n\n  // Pending host approval state\n  if (pendingJoin && !room) {\n    return (\n      <div className=\"max-w-2xl mx-auto py-8 space-y-6\">\n        <div className=\"rounded-lg border border-amber-500/30 bg-[#111827] p-6 space-y-4\">\n          <h1 className=\"text-xl font-semibold text-white\">Waiting for host approval</h1>\n          <p className=\"text-sm text-slate-300\">\n            Verify the host identity below before exchanging messages or files.\n          </p>\n          <dl className=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-2 border-t border-slate-800 text-sm\">\n            <div>\n              <dt className=\"text-xs text-slate-400\">Target Room</dt>\n              <dd className=\"mt-1 font-medium text-white\">{pendingJoin.roomName}</dd>\n            </div>\n            <div>\n              <dt className=\"text-xs text-slate-400\">Host Device</dt>\n              <dd className=\"mt-1 font-medium text-white\">{pendingJoin.hostName}</dd>\n            </div>\n            <div className=\"sm:col-span-2\">\n              <dt className=\"text-xs text-slate-400\">Host Cryptographic Fingerprint</dt>\n              <dd className=\"mt-1 font-mono text-xs text-emerald-300 break-all\">\n                {pendingJoin.hostFingerprint || \'Unavailable\'}\n              </dd>\n            </div>\n          </dl>\n        </div>\n      </div>\n    );\n  }\n\n  // Idle Lobby: Create Room + Join Room\n  if (!room) {\n    return (\n      <div className=\"max-w-5xl mx-auto space-y-8\">\n        <div>\n          <h1 className=\"text-2xl md:text-3xl font-bold tracking-tight text-white\">\n            Connect terminals directly with a 2-digit code\n          </h1>\n          <p className=\"mt-2 text-sm md:text-base text-slate-400 max-w-2xl\">\n            Create an encrypted peer-to-peer room or join an active session from Windows, Linux, macOS, VMs, or this companion console.\n          </p>\n        </div>\n\n        {/* Collision disambiguation modal/panel when multiple rooms share the same 2-digit code */}\n        {candidates.length > 0 ? (\n          <section aria-label=\"Select matching room\" className=\"rounded-lg border border-amber-500/40 bg-[#111827] p-5 space-y-4\">\n            <div className=\"flex items-center justify-between gap-4\">\n              <div>\n                <h2 className=\"text-base font-semibold text-white\">Multiple rooms share this code</h2>\n                <p className=\"text-xs text-slate-400 mt-0.5\">\n                  Two-digit codes are discovery identifiers. Select the intended host by verifying its device name and fingerprint.\n                </p>\n              </div>\n              <button\n                type=\"button\"\n                onClick={onClearCandidates}\n                className=\"text-xs text-slate-400 hover:text-white whitespace-nowrap\"\n              >\n                Dismiss\n              </button>\n            </div>\n            <div className=\"divide-y divide-slate-800 border-t border-slate-800\">\n              {candidates.map((c) => (\n                <div key={c.roomId} className=\"py-3 flex flex-col sm:flex-row sm:items-center justify-between gap-3\">\n                  <div className=\"space-y-0.5\">\n                    <div className=\"text-sm font-medium text-white\">{c.roomName}</div>\n                    <div className=\"text-xs text-slate-400\">\n                      Host: <span className=\"text-slate-200\">{c.hostName}</span> \302\267 {c.hostPlatform} \302\267{\' \'}\n                      <span className=\"font-mono\">{c.hostFingerprintShort}...</span> \302\267 {c.memberCount}/{c.maxPeers} peers\n                    </div>\n                  </div>\n                  <button\n                    type=\"button\"\n                    onClick={() => onJoinRoomId(c.roomId, joinPassword || undefined)}\n                    className=\"px-3.5 py-2 rounded-md bg-emerald-600 hover:bg-emerald-500 text-xs font-semibold text-white whitespace-nowrap shrink-0\"\n                  >\n                    Request Join\n                  </button>\n                </div>\n              ))}\n            </div>\n          </section>\n        ) : null}\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch\">\n          {/* Primary Action: Create Room */}\n          <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6 flex flex-col justify-between space-y-5\">\n            <div className=\"space-y-5\">\n              <div>\n                <h2 className=\"text-lg font-semibold text-white\">Create a room</h2>\n                <p className=\"mt-1 text-xs text-slate-400\">\n                  Generates a dynamic 2-digit code (00\342\200\22399) and shareable invite link. Host approval is enabled by default.\n                </p>\n              </div>\n\n              <div className=\"space-y-4\">\n                <div>\n                  <label htmlFor=\"create-room-name\" className=\"block text-xs font-medium text-slate-300 mb-1.5\">\n                    Room Name\n                  </label>\n                  <input\n                    id=\"create-room-name\"\n                    type=\"text\"\n                    value={roomName}\n                    maxLength={64}\n                    onChange={(e) => setRoomName(e.target.value)}\n                    placeholder=\"DEV TEAM\"\n                    className=\"w-full rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-2 text-sm text-white placeholder:text-slate-500 focus:border-emerald-500 focus:outline-none\"\n                  />\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-4\">\n                  <div>\n                    <label htmlFor=\"create-max-peers\" className=\"block text-xs font-medium text-slate-300 mb-1.5\">\n                      Max Peers (2\342\200\22320)\n                    </label>\n                    <select\n                      id=\"create-max-peers\"\n                      value={maxPeers}\n                      onChange={(e) => setMaxPeers(Number(e.target.value))}\n                      className=\"w-full rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-2 text-sm text-white focus:border-emerald-500 focus:outline-none\"\n                    >\n                      <option value={4}>4 peers (Full Mesh)</option>\n                      <option value={8}>8 peers (Full Mesh \302\267 Recommended)</option>\n                      <option value={12}>12 peers (Hybrid Experimental)</option>\n                      <option value={20}>20 peers (Hybrid Experimental)</option>\n                    </select>\n                  </div>\n\n                  <div>\n                    <label htmlFor=\"create-password\" className=\"block text-xs font-medium text-slate-300 mb-1.5\">\n                      Optional Password\n                    </label>\n                    <input\n                      id=\"create-password\"\n                      type=\"password\"\n                      value={createPassword}\n                      onChange={(e) => setCreatePassword(e.target.value)}\n                      placeholder=\"Leave blank for approval-only\"\n                      className=\"w-full rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-2 text-sm text-white placeholder:text-slate-500 focus:border-emerald-500 focus:outline-none\"\n                    />\n                  </div>\n                </div>\n\n                <div className=\"space-y-2.5 pt-1\">\n                  <label className=\"flex items-start gap-2.5 text-xs text-slate-300 cursor-pointer\">\n                    <input\n                      type=\"checkbox\"\n                      checked={requireApproval}\n                      onChange={(e) => setRequireApproval(e.target.checked)}\n                      className=\"mt-0.5 rounded border-slate-600 bg-[#0B0F17] text-emerald-500 focus:ring-emerald-500\"\n                    />\n                    <span>Require explicit host approval before new peers can join (recommended)</span>\n                  </label>\n                  <label className=\"flex items-start gap-2.5 text-xs text-slate-300 cursor-pointer\">\n                    <input\n                      type=\"checkbox\"\n                      checked={publicQuickConnect}\n                      onChange={(e) => setPublicQuickConnect(e.target.checked)}\n                      className=\"mt-0.5 rounded border-slate-600 bg-[#0B0F17] text-emerald-500 focus:ring-emerald-500\"\n                    />\n                    <span>Allow 2-digit quick-connect discovery (disable for invite-link-only rooms)</span>\n                  </label>\n                </div>\n              </div>\n            </div>\n\n            <button\n              type=\"button\"\n              disabled={!signalingConnected}\n              onClick={() =>\n                onCreateRoom({\n                  roomName: roomName.trim() || `${localDeviceName} Room`,\n                  requireHostApproval: requireApproval,\n                  publicQuickConnect,\n                  password: createPassword || undefined,\n                  maxPeers,\n                })\n              }\n              className=\"w-full inline-flex items-center justify-center gap-2 rounded-md bg-emerald-600 hover:bg-emerald-500 disabled:opacity-50 px-4 py-2.5 text-sm font-semibold text-white transition-colors\"\n            >\n              <span>Create Room & Get 2-Digit Code</span>\n              <ArrowRight className=\"h-4 w-4\" />\n            </button>\n          </section>\n\n          {/* Secondary Action: Join Room */}\n          <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6 flex flex-col justify-between space-y-5\">\n            <form onSubmit={handleJoinSubmit} className=\"space-y-5 flex-1 flex flex-col justify-between\">\n              <div className=\"space-y-4\">\n                <div>\n                  <h2 className=\"text-lg font-semibold text-white\">Join an existing room</h2>\n                  <p className=\"mt-1 text-xs text-slate-400\">\n                    Enter a 2-digit code (e.g. 47) or paste a full TermLink join or secure invitation link.\n                  </p>\n                </div>\n\n                <div>\n                  <label htmlFor=\"join-target-input\" className=\"block text-xs font-medium text-slate-300 mb-1.5\">\n                    2-Digit Code or Invite Link\n                  </label>\n                  <input\n                    id=\"join-target-input\"\n                    type=\"text\"\n                    value={joinInput}\n                    onChange={(e) => {\n                      setJoinInput(e.target.value);\n                      if (joinValidationError) setJoinValidationError(null);\n                    }}\n                    placeholder=\"47 or http://localhost:3000/invite/...\"\n                    className=\"w-full rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-2.5 font-mono text-base text-white placeholder:text-slate-500 focus:border-emerald-500 focus:outline-none\"\n                  />\n                  {joinValidationError ? (\n                    <p role=\"alert\" className=\"mt-1.5 text-xs text-red-400\">\n                      {joinValidationError}\n                    </p>\n                  ) : null}\n                </div>\n\n                <div>\n                  <label htmlFor=\"join-password-input\" className=\"block text-xs font-medium text-slate-300 mb-1.5\">\n                    Room Password (if required)\n                  </label>\n                  <input\n                    id=\"join-password-input\"\n                    type=\"password\"\n                    value={joinPassword}\n                    onChange={(e) => setJoinPassword(e.target.value)}\n                    placeholder=\"Optional\"\n                    className=\"w-full rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-2 text-sm text-white placeholder:text-slate-500 focus:border-emerald-500 focus:outline-none\"\n                  />\n                </div>\n              </div>\n\n              <button\n                type=\"submit\"\n                disabled={!signalingConnected}\n                className=\"w-full rounded-md border border-slate-700 bg-slate-800 hover:bg-slate-700 disabled:opacity-50 px-4 py-2.5 text-sm font-semibold text-white transition-colors\"\n              >\n                Join Room\n              </button>\n            </form>\n          </section>\n        </div>\n\n        {/* Concise CLI Quick Start */}\n        <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-5\">\n          <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-4\">\n            <div>\n              <h2 className=\"text-sm font-semibold text-white\">Connect from any terminal</h2>\n              <p className=\"text-xs text-slate-400 mt-0.5\">\n                Terminal peers running on Windows, Linux, macOS, VMware, or VirtualBox connect to this exact same signaling server and rooms.\n              </p>\n            </div>\n            <div className=\"flex flex-wrap items-center gap-3 font-mono text-xs text-emerald-300\">\n              <code className=\"rounded bg-[#0B0F17] border border-slate-800 px-3 py-1.5\">npm run cli -- create</code>\n              <code className=\"rounded bg-[#0B0F17] border border-slate-800 px-3 py-1.5\">npm run cli -- 47</code>\n            </div>\n          </div>\n        </section>\n      </div>\n    );\n  }\n\n  // Active Room View\n  const cliJoinCmd = `termlink ${room.code}`;\n  const liveJoinUrl = `${window.location.origin}/join/${room.code}`;\n\n  return (\n    <div className=\"max-w-5xl mx-auto space-y-6\">\n      {/* Primary Room Code Header */}\n      <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-6\">\n        <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-6\">\n          <div className=\"space-y-2\">\n            <div className=\"flex items-center gap-3 text-xs text-slate-400\">\n              <span>{room.publicQuickConnect ? \'Public 2-digit discovery enabled\' : \'Invite-only room\'}</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span>{room.requireHostApproval ? \'Host approval required\' : \'Open join\'}</span>\n              <span aria-hidden=\"true\">\302\267</span>\n              <span className=\"tabular-nums\">\n                {room.members.length}/{room.maxPeers} connected\n              </span>\n            </div>\n            <h1 className=\"text-2xl font-bold text-white\">{room.roomName}</h1>\n            <div className=\"flex flex-wrap items-center gap-3 pt-1\">\n              <button\n                type=\"button\"\n                onClick={() => copyText(\'cli\', cliJoinCmd)}\n                className=\"inline-flex items-center gap-2 rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-1.5 font-mono text-xs text-emerald-300 hover:border-emerald-500/60\"\n              >\n                <span>{cliJoinCmd}</span>\n                {copiedKey === \'cli\' ? <Check className=\"h-3.5 w-3.5 text-emerald-400\" /> : <Copy className=\"h-3.5 w-3.5 text-slate-400\" />}\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => copyText(\'url\', liveJoinUrl)}\n                className=\"inline-flex items-center gap-2 rounded-md border border-slate-700 bg-[#0B0F17] px-3 py-1.5 font-mono text-xs text-slate-200 hover:border-slate-500 max-w-full\"\n              >\n                <Link2 className=\"h-3.5 w-3.5 text-slate-400 shrink-0\" />\n                <span className=\"truncate\">{liveJoinUrl}</span>\n                {copiedKey === \'url\' ? <Check className=\"h-3.5 w-3.5 text-emerald-400 shrink-0\" /> : <Copy className=\"h-3.5 w-3.5 text-slate-400 shrink-0\" />}\n              </button>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-4 shrink-0\">\n            <div className=\"rounded-lg border border-emerald-500/35 bg-[#0B0F17] px-6 py-4 text-center\">\n              <div className=\"text-[11px] font-medium text-slate-400\">Room Code</div>\n              <div\n                data-testid=\"active-room-code\"\n                className=\"mt-1 font-mono text-4xl font-bold tracking-widest text-emerald-400 tabular-nums\"\n              >\n                {room.code}\n              </div>\n            </div>\n            {isOwner ? (\n              <div className=\"flex flex-col gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={onRotateCode}\n                  className=\"inline-flex items-center justify-center gap-1.5 rounded-md border border-slate-700 bg-slate-800 hover:bg-slate-700 px-3 py-2 text-xs font-medium text-slate-200 whitespace-nowrap\"\n                >\n                  <RefreshCw className=\"h-3.5 w-3.5\" />\n                  Rotate Code\n                </button>\n                <button\n                  type=\"button\"\n                  onClick={onCloseRoom}\n                  className=\"inline-flex items-center justify-center gap-1.5 rounded-md border border-red-900/70 bg-red-950/50 hover:bg-red-900/60 px-3 py-2 text-xs font-medium text-red-200 whitespace-nowrap\"\n                >\n                  Close Room\n                </button>\n              </div>\n            ) : null}\n          </div>\n        </div>\n      </section>\n\n      {/* Pending Join Approval Queue */}\n      {joinRequests.length > 0 ? (\n        <section aria-label=\"Pending peer approvals\" className=\"rounded-lg border border-amber-500/40 bg-[#111827] p-5 space-y-4\">\n          <div className=\"flex items-center gap-2 text-amber-300\">\n            <ShieldCheck className=\"h-4 w-4\" />\n            <h2 className=\"text-sm font-semibold\">Pending Host Approvals ({joinRequests.length})</h2>\n          </div>\n          <div className=\"divide-y divide-slate-800\">\n            {joinRequests.map((req) => {\n              const selectedRole = approvalRoles[req.requestId] || \'collaborator\';\n              return (\n                <div key={req.requestId} className=\"py-3 flex flex-col md:flex-row md:items-center justify-between gap-4\">\n                  <div className=\"space-y-1\">\n                    <div className=\"text-sm font-medium text-white\">\n                      {req.identity.deviceName}{\' \'}\n                      <span className=\"text-xs font-normal text-slate-400\">({req.identity.platform})</span>\n                    </div>\n                    <div className=\"font-mono text-xs text-slate-400 break-all\">\n                      Fingerprint: {req.identity.fingerprint}\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-2 shrink-0\">\n                    <select\n                      aria-label={`Assign role for ${req.identity.deviceName}`}\n                      value={selectedRole}\n                      onChange={(e) =>\n                        setApprovalRoles((prev) => ({ ...prev, [req.requestId]: e.target.value as PeerRole }))\n                      }\n                      className=\"rounded-md border border-slate-700 bg-[#0B0F17] px-2.5 py-1.5 text-xs text-slate-200\"\n                    >\n                      <option value=\"collaborator\">Collaborator</option>\n                      <option value=\"viewer\">Viewer</option>\n                      <option value=\"guest\">Guest</option>\n                      {isOwner ? <option value=\"admin\">Admin</option> : null}\n                    </select>\n                    <button\n                      type=\"button\"\n                      onClick={() => onApproveJoin(req.requestId, selectedRole)}\n                      className=\"rounded-md bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 text-xs font-semibold text-white whitespace-nowrap\"\n                    >\n                      Approve\n                    </button>\n                    <button\n                      type=\"button\"\n                      onClick={() => onRejectJoin(req.requestId)}\n                      className=\"rounded-md border border-slate-700 bg-slate-800 hover:bg-red-950/70 hover:text-red-200 px-3 py-1.5 text-xs font-medium text-slate-200 whitespace-nowrap\"\n                    >\n                      Reject\n                    </button>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </section>\n      ) : null}\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Secure Invitation Links */}\n        <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-5 space-y-4\">\n          <div className=\"flex items-center gap-2\">\n            <KeyRound className=\"h-4 w-4 text-emerald-400\" />\n            <h2 className=\"text-base font-semibold text-white\">Secure Invitation Links</h2>\n          </div>\n          <p className=\"text-xs text-slate-400\">\n            Generate cryptographically random invite tokens with role scoping, expiration, and revocation. Ideal when public 2-digit discovery is disabled.\n          </p>\n\n          {canInvite ? (\n            <div className=\"flex flex-wrap items-end gap-3 pt-1\">\n              <div>\n                <label htmlFor=\"invite-role-select\" className=\"block text-[11px] text-slate-400 mb-1\">\n                  Role\n                </label>\n                <select\n                  id=\"invite-role-select\"\n                  value={inviteRole}\n                  onChange={(e) => setInviteRole(e.target.value as PeerRole)}\n                  className=\"rounded-md border border-slate-700 bg-[#0B0F17] px-2.5 py-1.5 text-xs text-slate-100\"\n                >\n                  <option value=\"collaborator\">Collaborator</option>\n                  <option value=\"viewer\">Viewer</option>\n                  <option value=\"guest\">Guest</option>\n                  {isOwner ? <option value=\"admin\">Admin</option> : null}\n                </select>\n              </div>\n              <div>\n                <label htmlFor=\"invite-ttl-select\" className=\"block text-[11px] text-slate-400 mb-1\">\n                  Expires\n                </label>\n                <select\n                  id=\"invite-ttl-select\"\n                  value={inviteTtlMin}\n                  onChange={(e) => setInviteTtlMin(Number(e.target.value))}\n                  className=\"rounded-md border border-slate-700 bg-[#0B0F17] px-2.5 py-1.5 text-xs text-slate-100\"\n                >\n                  <option value={15}>15 minutes</option>\n                  <option value={60}>1 hour</option>\n                  <option value={1440}>24 hours</option>\n                </select>\n              </div>\n              <label className=\"flex items-center gap-1.5 text-xs text-slate-300 py-1.5 cursor-pointer\">\n                <input\n                  type=\"checkbox\"\n                  checked={inviteOneTime}\n                  onChange={(e) => setInviteOneTime(e.target.checked)}\n                  className=\"rounded border-slate-600 bg-[#0B0F17]\"\n                />\n                One-time\n              </label>\n              <button\n                type=\"button\"\n                onClick={() =>\n                  onCreateInvite({\n                    role: inviteRole,\n                    oneTime: inviteOneTime,\n                    expiresInMs: inviteTtlMin * 60 * 1000,\n                  })\n                }\n                className=\"rounded-md bg-emerald-600 hover:bg-emerald-500 px-3 py-1.5 text-xs font-semibold text-white whitespace-nowrap\"\n              >\n                Generate Invite\n              </button>\n            </div>\n          ) : (\n            <p className=\"text-xs text-slate-500\">Only room owners and admins can issue invitation tokens.</p>\n          )}\n\n          {invites.length > 0 ? (\n            <ul className=\"divide-y divide-slate-800 border-t border-slate-800 pt-2\">\n              {invites.map((inv) => {\n                const fullUrl = `${window.location.origin}/invite/${inv.token}`;\n                return (\n                  <li key={inv.token} className=\"py-2.5 flex items-center justify-between gap-2 text-xs\">\n                    <div className=\"min-w-0\">\n                      <div className=\"font-mono text-slate-200 truncate\">{fullUrl}</div>\n                      <div className=\"text-[11px] text-slate-400\">\n                        Role: {inv.role} \302\267 {inv.oneTime ? \'One-time\' : \'Multi-use\'} \302\267{\' \'}\n                        {inv.revoked ? \'Revoked\' : `Expires ${new Date(inv.expiresAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}`}\n                      </div>\n                    </div>\n                    <div className=\"flex items-center gap-1.5 shrink-0\">\n                      <button\n                        type=\"button\"\n                        onClick={() => copyText(inv.token, fullUrl)}\n                        aria-label=\"Copy invite URL\"\n                        className=\"p-1.5 rounded bg-slate-800 hover:bg-slate-700 text-slate-200\"\n                      >\n                        {copiedKey === inv.token ? <Check className=\"h-3.5 w-3.5 text-emerald-400\" /> : <Copy className=\"h-3.5 w-3.5\" />}\n                      </button>\n                      {!inv.revoked && canInvite ? (\n                        <button\n                          type=\"button\"\n                          onClick={() => onRevokeInvite(inv.token)}\n                          aria-label=\"Revoke invite\"\n                          className=\"p-1.5 rounded bg-slate-800 hover:bg-red-950/70 text-red-300\"\n                        >\n                          <Trash2 className=\"h-3.5 w-3.5\" />\n                        </button>\n                      ) : null}\n                    </div>\n                  </li>\n                );\n              })}\n            </ul>\n          ) : null}\n        </section>\n\n        {/* Room Security Policy */}\n        <section className=\"rounded-lg border border-slate-800 bg-[#111827] p-5 space-y-4\">\n          <h2 className=\"text-base font-semibold text-white\">Room Security Controls</h2>\n          <p className=\"text-xs text-slate-400\">\n            Two-digit codes are never used as encryption keys. All peer messages, file chunks, and terminal streams are encrypted end-to-end.\n          </p>\n\n          <div className=\"space-y-3 pt-1\">\n            <label className=\"flex items-center justify-between gap-4 py-2 border-b border-slate-800/80 text-xs\">\n              <div>\n                <div className=\"font-medium text-slate-200\">Require host approval</div>\n                <div className=\"text-slate-400\">New peers joining via 2-digit code wait in approval queue</div>\n              </div>\n              <input\n                type=\"checkbox\"\n                disabled={!isOwner}\n                checked={room.requireHostApproval}\n                onChange={(e) => onUpdateSettings({ requireHostApproval: e.target.checked })}\n                className=\"h-4 w-4 rounded border-slate-600 bg-[#0B0F17]\"\n              />\n            </label>\n\n            <label className=\"flex items-center justify-between gap-4 py-2 border-b border-slate-800/80 text-xs\">\n              <div>\n                <div className=\"font-medium text-slate-200\">Public 2-digit quick-connect</div>\n                <div className=\"text-slate-400\">Disable to hide room from 2-digit code lookup</div>\n              </div>\n              <input\n                type=\"checkbox\"\n                disabled={!isOwner}\n                checked={room.publicQuickConnect}\n                onChange={(e) => onUpdateSettings({ publicQuickConnect: e.target.checked })}\n                className=\"h-4 w-4 rounded border-slate-600 bg-[#0B0F17]\"\n              />\n            </label>\n\n            <div className=\"flex items-center justify-between text-xs py-1\">\n              <span className=\"text-slate-400\">Password protection</span>\n              <span className=\"text-slate-200\">{room.hasPassword ? \'Enabled\' : \'Not set\'}</span>\n            </div>\n\n            <div className=\"flex items-center justify-between text-xs py-1\">\n              <span className=\"text-slate-400\">Code expiration</span>\n              <span className=\"font-mono text-slate-200 tabular-nums\">\n                {new Date(room.codeExpiresAt).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\n              </span>\n            </div>\n          </div>\n        </section>\n      </div>\n    </div>\n  );\n};\n"
