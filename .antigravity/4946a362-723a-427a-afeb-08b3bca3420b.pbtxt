  code_action {
    action_spec {
      create_file {
        instruction: "name: TermLink Release\n\non:\n  push:\n    tags:\n      - \'v*.*.*\'\n\npermissions:\n  contents: write\n  id-token: write\n\njobs:\n  release:\n    name: Validate & Publish Release\n    runs-on: ubuntu-latest\n    environment: npm-release\n\n    steps:\n      - name: Checkout tag\n        uses: actions/checkout@v4\n\n      - name: Setup Node.js\n        uses: actions/setup-node@v4\n        with:\n          node-version: 22\n          registry-url: \'https://registry.npmjs.org\'\n\n      - name: Install dependencies\n        run: npm ci\n\n      - name: Verify version matches git tag\n        run: |\n          TAG_VER=\"${GITHUB_REF_NAME#v}\"\n          PKG_VER=\"$(node -p \"require(\'./package.json\').version\")\"\n          test \"$TAG_VER\" = \"$PKG_VER\"\n\n      - name: Run full test suite & build\n        run: |\n          npm run lint\n          npm test\n          npm run build\n          npm pack --dry-run\n\n      - name: Publish to npm (requires environment approval & NPM_TOKEN secret)\n        if: ${{ env.NPM_TOKEN != \'\' }}\n        run: npm publish --provenance --access public\n        env:\n          NODE_AUTH_TOKEN: ${{ secrets.NPM_TOKEN }}\n"
        path {
          absolute_uri: "file:///.github/workflows/release.yml"
        }
        overwrite: true
      }
    }
