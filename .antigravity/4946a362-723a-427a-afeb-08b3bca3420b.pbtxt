      original_chunk {
        target_content: "            onChunk: async (chunkIndex, totalChunks, sha256, dataBase64) => {\n              const ackKey = `${fromPeerId}:${chunkIndex}`;\n              const ackPromise = new Promise<void>((resolve) => {\n                active.ackWaiters.set(ackKey, resolve);\n                // Safety timeout so broken peers cannot deadlock indefinitely\n                setTimeout(() => {\n                  if (active.ackWaiters.has(ackKey)) {\n                    active.ackWaiters.delete(ackKey);\n                    resolve();\n                  }\n                }, 15_000);\n              });\n\n              this.transport.sendToPeer(fromPeerId, {\n                kind: \'file:chunk\',\n                transferId: payload.transferId,\n                chunkIndex,\n                totalChunks,\n                sha256,\n                dataBase64,\n              });\n              await ackPromise;\n            },"
        replacement_content: "            onChunk: async (chunkIndex, totalChunks, sha256, dataBase64) => {\n              const ackKey = `${fromPeerId}:${chunkIndex}`;\n              const ackPromise = new Promise<void>((resolve) => {\n                const timer = setTimeout(() => {\n                  if (active.ackWaiters.has(ackKey)) {\n                    active.ackWaiters.delete(ackKey);\n                    resolve();\n                  }\n                }, 15_000);\n                timer.unref?.();\n                active.ackWaiters.set(ackKey, () => {\n                  clearTimeout(timer);\n                  resolve();\n                });\n              });\n\n              this.transport.sendToPeer(fromPeerId, {\n                kind: \'file:chunk\',\n                transferId: payload.transferId,\n                chunkIndex,\n                totalChunks,\n                sha256,\n                dataBase64,\n              });\n              await ackPromise;\n            },"
