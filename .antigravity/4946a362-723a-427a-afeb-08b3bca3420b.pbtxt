  code_action {
    action_spec {
      create_file {
        instruction: "import type {\n  ConnectionMode,\n  PeerPublicIdentity,\n  PeerRole,\n  RoomMember,\n  TerminalAccessMode,\n} from \'../../packages/core/src/index\';\nimport type {\n  ClientSignalingMessage,\n  EncryptedEnvelope,\n  InviteRecord,\n  PeerDataPayload,\n  PendingJoinRequest,\n  RoomCandidate,\n  RoomInfo,\n  ServerSignalingMessage,\n} from \'../../packages/protocol/src/index\';\nimport {\n  arrayBufferToBase64,\n  base64ToUint8Array,\n  openBrowserPayload,\n  sealBrowserPayload,\n  sha256Hex,\n  type BrowserLocalIdentity,\n} from \'./browserCrypto\';\n\nconst BROWSER_CHUNK_SIZE = 48 * 1024; // 48 KiB safe WebRTC DataChannel & WS chunk size\n\nexport interface ChatItem {\n  id: string;\n  kind: \'group\' | \'private\' | \'system\';\n  senderPeerId: string;\n  senderName: string;\n  toPeerName?: string;\n  text: string;\n  timestamp: number;\n  connectionMode?: ConnectionMode;\n  delivered?: boolean;\n}\n\nexport interface CommandProposalItem {\n  proposalId: string;\n  direction: \'incoming\' | \'outgoing\';\n  peerId: string;\n  peerName: string;\n  command: string;\n  description?: string;\n  timestamp: number;\n  status: \'pending\' | \'accepted\' | \'rejected\' | \'edited\';\n  editedCommand?: string;\n}\n\nexport interface FileTransferItem {\n  transferId: string;\n  direction: \'send\' | \'receive\';\n  peerId: string;\n  peerName: string;\n  filename: string;\n  size: number;\n  sha256: string;\n  totalChunks: number;\n  completedChunks: number;\n  bytesTransferred: number;\n  percent: number;\n  speedBytesPerSec: number;\n  etaSeconds: number;\n  status: \'offering\' | \'transferring\' | \'paused\' | \'completed\' | \'cancelled\' | \'rejected\' | \'failed\';\n  verified?: boolean;\n  downloadUrl?: string;\n  error?: string;\n  startedAt: number;\n}\n\nexport interface WebClientCallbacks {\n  onSignalingState: (connected: boolean, peerId: string, stunServers: string[], hasTurn: boolean) => void;\n  onRoomUpdated: (room: RoomInfo | null, reconnectToken?: string) => void;\n  onCandidates: (code: string, candidates: RoomCandidate[]) => void;\n  onPendingJoin: (info: { roomId: string; roomName: string; hostName: string; hostFingerprint: string } | null) => void;\n  onJoinRequest: (req: PendingJoinRequest) => void;\n  onInviteCreated: (invite: InviteRecord) => void;\n  onInviteRevoked: (token: string) => void;\n  onChatMessage: (msg: ChatItem) => void;\n  onMessageDelivered: (messageId: string) => void;\n  onCommandProposal: (item: CommandProposalItem) => void;\n  onCommandDecision: (proposalId: string, decision: CommandProposalItem[\'status\'], editedCommand?: string) => void;\n  onFileTransferUpdate: (item: FileTransferItem) => void;\n  onPeerConnectionMode: (peerId: string, mode: ConnectionMode) => void;\n  onRemoteTerminalState: (state: {\n    sessionId: string;\n    sessionName: string;\n    ownerPeerId: string;\n    ownerName: string;\n    active: boolean;\n    locked: boolean;\n    shell: string;\n    permissions: Record<string, TerminalAccessMode>;\n  } | null) => void;\n  onRemoteTerminalOutput: (data: string) => void;\n  onError: (code: string, message: string) => void;\n}\n\ninterface OutgoingTransferControl {\n  file: File;\n  paused: boolean;\n  cancelled: boolean;\n  resumeResolvers: Array<() => void>;\n  ackWaiters: Map<string, () => void>;\n  item: FileTransferItem;\n}\n\ninterface IncomingTransferBuffer {\n  chunks: Uint8Array[];\n  receivedCount: number;\n  bytesReceived: number;\n  startedAt: number;\n  item: FileTransferItem;\n}\n\nexport class TermLinkWebClient {\n  private ws: WebSocket | null = null;\n  private peerId = \'\';\n  private identity: BrowserLocalIdentity;\n  private callbacks: WebClientCallbacks;\n  private currentRoom: RoomInfo | null = null;\n  private stunServers: string[] = [\'stun:stun.l.google.com:19302\'];\n\n  private readonly rtcPeers = new Map<string, RTCPeerConnection>();\n  private readonly dataChannels = new Map<string, RTCDataChannel>();\n  private readonly peerModes = new Map<string, ConnectionMode>();\n  private readonly peerIdentities = new Map<string, PeerPublicIdentity>();\n\n  private readonly outgoingFiles = new Map<string, OutgoingTransferControl>();\n  private readonly incomingFiles = new Map<string, IncomingTransferBuffer>();\n  private readonly pendingOffers = new Map<\n    string,\n    { fromPeerId: string; senderName: string; filename: string; size: number; sha256: string; totalChunks: number }\n  >();\n\n  private reconnectTimer: number | null = null;\n  private closedManually = false;\n\n  constructor(identity: BrowserLocalIdentity, callbacks: WebClientCallbacks) {\n    this.identity = identity;\n    this.callbacks = callbacks;\n  }\n\n  getPeerId(): string {\n    return this.peerId;\n  }\n\n  updateIdentity(identity: BrowserLocalIdentity): void {\n    this.identity = identity;\n    if (this.ws && this.ws.readyState === WebSocket.OPEN) {\n      this.sendSignal({ type: \'hello\', identity: identity.publicIdentity });\n    }\n  }\n\n  connect(): void {\n    this.closedManually = false;\n    const proto = window.location.protocol === \'https:\' ? \'wss:\' : \'ws:\';\n    const wsUrl = `${proto}//${window.location.host}/ws`;\n    const ws = new WebSocket(wsUrl);\n    this.ws = ws;\n\n    ws.onmessage = (ev) => {\n      try {\n        const msg = JSON.parse(String(ev.data)) as ServerSignalingMessage;\n        void this.handleServerMessage(msg);\n      } catch {\n        // ignore malformed frame\n      }\n    };\n\n    ws.onclose = () => {\n      this.callbacks.onSignalingState(false, this.peerId, this.stunServers, false);\n      if (!this.closedManually) {\n        this.reconnectTimer = window.setTimeout(() => this.connect(), 2000);\n      }\n    };\n\n    ws.onerror = () => {\n      // onclose handles reconnect\n    };\n  }\n\n  disconnect(): void {\n    this.closedManually = true;\n    if (this.reconnectTimer !== null) {\n      clearTimeout(this.reconnectTimer);\n      this.reconnectTimer = null;\n    }\n    this.closeAllWebRTC();\n    this.ws?.close();\n    this.ws = null;\n  }\n\n  sendSignal(msg: ClientSignalingMessage): void {\n    if (this.ws && this.ws.readyState === WebSocket.OPEN) {\n      this.ws.send(JSON.stringify(msg));\n    }\n  }\n\n  createRoom(opts: {\n    roomName: string;\n    requireHostApproval: boolean;\n    publicQuickConnect: boolean;\n    password?: string;\n    maxPeers?: number;\n  }): void {\n    this.sendSignal({\n      type: \'room:create\',\n      roomName: opts.roomName,\n      requireHostApproval: opts.requireHostApproval,\n      publicQuickConnect: opts.publicQuickConnect,\n      password: opts.password || undefined,\n      maxPeers: opts.maxPeers ?? 8,\n    });\n  }\n\n  lookupCode(code: string): void {\n    this.sendSignal({ type: \'room:lookup\', code });\n  }\n\n  joinByCode(code: string, password?: string): void {\n    this.sendSignal({ type: \'room:join\', code, password: password || undefined });\n  }\n\n  joinByRoomId(roomId: string, password?: string): void {\n    this.sendSignal({ type: \'room:join\', roomId, password: password || undefined });\n  }\n\n  joinByInvite(inviteToken: string): void {\n    this.sendSignal({ type: \'room:join\', inviteToken });\n  }\n\n  approveJoin(requestId: string, role: PeerRole = \'collaborator\'): void {\n    this.sendSignal({ type: \'room:approve\', requestId, approved: true, role });\n  }\n\n  rejectJoin(requestId: string, reason?: string): void {\n    this.sendSignal({ type: \'room:approve\', requestId, approved: false, reason });\n  }\n\n  leaveRoom(): void {\n    this.sendSignal({ type: \'room:leave\' });\n    this.closeAllWebRTC();\n    this.currentRoom = null;\n    this.callbacks.onRoomUpdated(null);\n    this.callbacks.onRemoteTerminalState(null);\n  }\n\n  closeRoom(): void {\n    this.sendSignal({ type: \'room:close\' });\n    this.closeAllWebRTC();\n    this.currentRoom = null;\n    this.callbacks.onRoomUpdated(null);\n    this.callbacks.onRemoteTerminalState(null);\n  }\n\n  rotateCode(): void {\n    this.sendSignal({ type: \'room:rotate_code\' });\n  }\n\n  updateRoomSettings(settings: {\n    publicQuickConnect?: boolean;\n    requireHostApproval?: boolean;\n    password?: string | null;\n  }): void {\n    this.sendSignal({ type: \'room:update_settings\', ...settings });\n  }\n\n  createInvite(opts: { role: PeerRole; oneTime: boolean; expiresInMs: number }): void {\n    this.sendSignal({ type: \'room:create_invite\', ...opts });\n  }\n\n  revokeInvite(token: string): void {\n    this.sendSignal({ type: \'room:revoke_invite\', token });\n  }\n\n  kickPeer(targetPeerId: string): void {\n    this.sendSignal({ type: \'room:kick\', targetPeerId });\n  }\n\n  setPeerRole(targetPeerId: string, role: PeerRole): void {\n    this.sendSignal({ type: \'room:set_role\', targetPeerId, role });\n  }\n\n  transferOwnership(targetPeerId: string): void {\n    this.sendSignal({ type: \'room:transfer_ownership\', targetPeerId });\n  }\n\n  setTerminalAccess(targetPeerId: string, access: TerminalAccessMode): void {\n    this.sendSignal({ type: \'room:set_terminal_access\', targetPeerId, access });\n  }\n\n  async sendGroupMessage(text: string): Promise<ChatItem> {\n    const messageId = `msg_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;\n    const payload: PeerDataPayload = {\n      kind: \'chat:group\',\n      messageId,\n      text,\n      senderName: this.identity.publicIdentity.deviceName,\n      senderPeerId: this.peerId,\n      timestamp: Date.now(),\n    };\n\n    const peers = this.getRemoteMembers();\n    let mode: ConnectionMode = \'local_network\';\n    for (const m of peers) {\n      mode = await this.sendPeerPayload(m.peerId, payload);\n    }\n\n    const localItem: ChatItem = {\n      id: messageId,\n      kind: \'group\',\n      senderPeerId: this.peerId,\n      senderName: this.identity.publicIdentity.deviceName,\n      text,\n      timestamp: payload.timestamp,\n      connectionMode: peers.length > 0 ? mode : undefined,\n      delivered: peers.length === 0,\n    };\n    this.callbacks.onChatMessage(localItem);\n    return localItem;\n  }\n\n  async sendPrivateMessage(targetPeerId: string, text: string): Promise<ChatItem | null> {\n    const target = this.currentRoom?.members.find((m) => m.peerId === targetPeerId);\n    if (!target) return null;\n\n    const messageId = `pm_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;\n    const payload: PeerDataPayload = {\n      kind: \'chat:private\',\n      messageId,\n      toPeerId: targetPeerId,\n      text,\n      senderName: this.identity.publicIdentity.deviceName,\n      senderPeerId: this.peerId,\n      timestamp: Date.now(),\n    };\n    const mode = await this.sendPeerPayload(targetPeerId, payload);\n\n    const localItem: ChatItem = {\n      id: messageId,\n      kind: \'private\',\n      senderPeerId: this.peerId,\n      senderName: this.identity.publicIdentity.deviceName,\n      toPeerName: target.identity.deviceName,\n      text,\n      timestamp: payload.timestamp,\n      connectionMode: mode,\n      delivered: false,\n    };\n    this.callbacks.onChatMessage(localItem);\n    return localItem;\n  }\n\n  async proposeCommand(targetPeerId: string, command: string, description?: string): Promise<void> {\n    const target = this.currentRoom?.members.find((m) => m.peerId === targetPeerId);\n    if (!target) return;\n    const proposalId = `cmd_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;\n    await this.sendPeerPayload(targetPeerId, {\n      kind: \'command:proposal\',\n      proposalId,\n      command,\n      description,\n      senderName: this.identity.publicIdentity.deviceName,\n      senderPeerId: this.peerId,\n      timestamp: Date.now(),\n    });\n    this.callbacks.onCommandProposal({\n      proposalId,\n      direction: \'outgoing\',\n      peerId: targetPeerId,\n      peerName: target.identity.deviceName,\n      command,\n      description,\n      timestamp: Date.now(),\n      status: \'pending\',\n    });\n  }\n\n  async respondCommandProposal(\n    proposalId: string,\n    targetPeerId: string,\n    decision: \'accepted\' | \'rejected\' | \'edited\',\n    editedCommand?: string\n  ): Promise<void> {\n    await this.sendPeerPayload(targetPeerId, {\n      kind: \'command:decision\',\n      proposalId,\n      decision,\n      editedCommand,\n      responderName: this.identity.publicIdentity.deviceName,\n      timestamp: Date.now(),\n    });\n    this.callbacks.onCommandDecision(proposalId, decision, editedCommand);\n  }\n\n  async sendFile(file: File, targetPeerId: string | \'group\'): Promise<void> {\n    const recipients =\n      targetPeerId === \'group\'\n        ? this.getRemoteMembers()\n        : this.getRemoteMembers().filter((m) => m.peerId === targetPeerId);\n\n    if (recipients.length === 0) {\n      this.callbacks.onError(\'NO_RECIPIENTS\', \'Connect at least one peer before sending a file.\');\n      return;\n    }\n\n    const buf = await file.arrayBuffer();\n    const sha256 = await sha256Hex(buf);\n    const totalChunks = Math.max(1, Math.ceil(file.size / BROWSER_CHUNK_SIZE));\n\n    for (const peer of recipients) {\n      const transferId = `ft_${Date.now()}_${Math.random().toString(36).slice(2, 7)}`;\n      const item: FileTransferItem = {\n        transferId,\n        direction: \'send\',\n        peerId: peer.peerId,\n        peerName: peer.identity.deviceName,\n        filename: file.name,\n        size: file.size,\n        sha256,\n        totalChunks,\n        completedChunks: 0,\n        bytesTransferred: 0,\n        percent: 0,\n        speedBytesPerSec: 0,\n        etaSeconds: 0,\n        status: \'offering\',\n        startedAt: Date.now(),\n      };\n      this.outgoingFiles.set(transferId, {\n        file,\n        paused: false,\n        cancelled: false,\n        resumeResolvers: [],\n        ackWaiters: new Map(),\n        item,\n      });\n      this.callbacks.onFileTransferUpdate({ ...item });\n\n      await this.sendPeerPayload(peer.peerId, {\n        kind: \'file:offer\',\n        transferId,\n        filename: file.name,\n        size: file.size,\n        sha256,\n        chunkSize: BROWSER_CHUNK_SIZE,\n        totalChunks,\n        target: targetPeerId,\n        allowPeerAssist: false,\n        senderName: this.identity.publicIdentity.deviceName,\n      });\n    }\n  }\n\n  async acceptIncomingFile(transferId: string): Promise<void> {\n    const offer = this.pendingOffers.get(transferId);\n    if (!offer) return;\n    this.pendingOffers.delete(transferId);\n\n    const item: FileTransferItem = {\n      transferId,\n      direction: \'receive\',\n      peerId: offer.fromPeerId,\n      peerName: offer.senderName,\n      filename: offer.filename,\n      size: offer.size,\n      sha256: offer.sha256,\n      totalChunks: offer.totalChunks,\n      completedChunks: 0,\n      bytesTransferred: 0,\n      percent: 0,\n      speedBytesPerSec: 0,\n      etaSeconds: 0,\n      status: \'transferring\',\n      startedAt: Date.now(),\n    };\n    this.incomingFiles.set(transferId, {\n      chunks: [],\n      receivedCount: 0,\n      bytesReceived: 0,\n      startedAt: Date.now(),\n      item,\n    });\n    this.callbacks.onFileTransferUpdate({ ...item });\n\n    await this.sendPeerPayload(offer.fromPeerId, {\n      kind: \'file:response\',\n      transferId,\n      accepted: true,\n      resumeFromChunk: 0,\n    });\n  }\n\n  async rejectIncomingFile(transferId: string): Promise<void> {\n    const offer = this.pendingOffers.get(transferId);\n    if (!offer) return;\n    this.pendingOffers.delete(transferId);\n    await this.sendPeerPayload(offer.fromPeerId, {\n      kind: \'file:response\',\n      transferId,\n      accepted: false,\n      reason: \'Declined by recipient\',\n    });\n    this.callbacks.onFileTransferUpdate({\n      transferId,\n      direction: \'receive\',\n      peerId: offer.fromPeerId,\n      peerName: offer.senderName,\n      filename: offer.filename,\n      size: offer.size,\n      sha256: offer.sha256,\n      totalChunks: offer.totalChunks,\n      completedChunks: 0,\n      bytesTransferred: 0,\n      percent: 0,\n      speedBytesPerSec: 0,\n      etaSeconds: 0,\n      status: \'rejected\',\n      startedAt: Date.now(),\n    });\n  }\n\n  pauseTransfer(transferId: string): void {\n    const out = this.outgoingFiles.get(transferId);\n    if (!out) return;\n    out.paused = true;\n    out.item.status = \'paused\';\n    this.callbacks.onFileTransferUpdate({ ...out.item });\n    void this.sendPeerPayload(out.item.peerId, { kind: \'file:control\', transferId, action: \'pause\' });\n  }\n\n  resumeTransfer(transferId: string): void {\n    const out = this.outgoingFiles.get(transferId);\n    if (!out) return;\n    out.paused = false;\n    out.item.status = \'transferring\';\n    this.callbacks.onFileTransferUpdate({ ...out.item });\n    const resolvers = out.resumeResolvers.splice(0);\n    for (const r of resolvers) r();\n    void this.sendPeerPayload(out.item.peerId, { kind: \'file:control\', transferId, action: \'resume\' });\n  }\n\n  cancelTransfer(transferId: string): void {\n    const out = this.outgoingFiles.get(transferId);\n    if (out) {\n      out.cancelled = true;\n      out.paused = false;\n      for (const r of out.resumeResolvers.splice(0)) r();\n      out.item.status = \'cancelled\';\n      this.callbacks.onFileTransferUpdate({ ...out.item });\n      void this.sendPeerPayload(out.item.peerId, { kind: \'file:control\', transferId, action: \'cancel\' });\n      this.outgoingFiles.delete(transferId);\n    }\n    const inc = this.incomingFiles.get(transferId);\n    if (inc) {\n      inc.item.status = \'cancelled\';\n      this.callbacks.onFileTransferUpdate({ ...inc.item });\n      void this.sendPeerPayload(inc.item.peerId, { kind: \'file:control\', transferId, action: \'cancel\' });\n      this.incomingFiles.delete(transferId);\n    }\n  }\n\n  async broadcastTerminalState(snapshot: {\n    sessionId: string;\n    sessionName: string;\n    ownerPeerId: string;\n    ownerName: string;\n    active: boolean;\n    locked: boolean;\n    shell: string;\n    permissions: Record<string, TerminalAccessMode>;\n  }): Promise<void> {\n    for (const m of this.getRemoteMembers()) {\n      await this.sendPeerPayload(m.peerId, {\n        kind: \'terminal:state\',\n        ...snapshot,\n      });\n    }\n  }\n\n  async broadcastTerminalOutput(sessionId: string, data: string, seq: number, permissions: Record<string, TerminalAccessMode>): Promise<void> {\n    for (const m of this.getRemoteMembers()) {\n      const access = permissions[m.peerId];\n      if (access === \'read-only\' || access === \'interactive\') {\n        await this.sendPeerPayload(m.peerId, {\n          kind: \'terminal:output\',\n          sessionId,\n          data,\n          seq,\n          timestamp: Date.now(),\n        });\n      }\n    }\n  }\n\n  async sendRemoteTerminalInput(ownerPeerId: string, sessionId: string, data: string): Promise<void> {\n    await this.sendPeerPayload(ownerPeerId, {\n      kind: \'terminal:input\',\n      sessionId,\n      data,\n    });\n  }\n\n  private getRemoteMembers(): RoomMember[] {\n    if (!this.currentRoom) return [];\n    return this.currentRoom.members.filter((m) => m.peerId !== this.peerId);\n  }\n\n  private async handleServerMessage(msg: ServerSignalingMessage): Promise<void> {\n    switch (msg.type) {\n      case \'welcome\': {\n        this.peerId = msg.peerId;\n        this.stunServers = msg.stunServers;\n        this.sendSignal({ type: \'hello\', identity: this.identity.publicIdentity });\n        this.callbacks.onSignalingState(true, msg.peerId, msg.stunServers, msg.hasTurn);\n        break;\n      }\n\n      case \'room:created\':\n      case \'room:joined\': {\n        this.currentRoom = msg.room;\n        this.callbacks.onPendingJoin(null);\n        for (const m of msg.room.members) {\n          if (m.peerId !== this.peerId) {\n            this.peerIdentities.set(m.peerId, m.identity);\n          }\n        }\n        this.callbacks.onRoomUpdated(msg.room, msg.reconnectToken);\n        this.callbacks.onChatMessage({\n          id: `sys_${Date.now()}`,\n          kind: \'system\',\n          senderPeerId: \'system\',\n          senderName: \'System\',\n          text:\n            msg.type === \'room:created\'\n              ? `Room \"${msg.room.roomName}\" created with code ${msg.room.code}.`\n              : `Joined room \"${msg.room.roomName}\" (code ${msg.room.code}).`,\n          timestamp: Date.now(),\n        });\n        // Initiate real WebRTC DataChannel handshakes with existing browser peers\n        if (msg.type === \'room:joined\') {\n          for (const m of msg.room.members) {\n            if (m.peerId !== this.peerId && m.identity.platform === \'browser\') {\n              void this.initiateWebRTC(m.peerId);\n            }\n          }\n        }\n        break;\n      }\n\n      case \'room:candidates\':\n        this.callbacks.onCandidates(msg.code, msg.candidates);\n        break;\n\n      case \'room:pending\':\n        this.callbacks.onPendingJoin({\n          roomId: msg.roomId,\n          roomName: msg.roomName,\n          hostName: msg.hostName,\n          hostFingerprint: msg.hostFingerprint,\n        });\n        break;\n\n      case \'room:join_request\':\n        this.callbacks.onJoinRequest(msg.request);\n        break;\n\n      case \'room:rejected\':\n        this.callbacks.onPendingJoin(null);\n        this.callbacks.onError(\'JOIN_REJECTED\', msg.reason);\n        break;\n\n      case \'room:updated\':\n        this.currentRoom = msg.room;\n        for (const m of msg.room.members) {\n          if (m.peerId !== this.peerId) {\n            this.peerIdentities.set(m.peerId, m.identity);\n          }\n        }\n        this.callbacks.onRoomUpdated(msg.room);\n        break;\n\n      case \'room:peer_joined\':\n        this.peerIdentities.set(msg.member.peerId, msg.member.identity);\n        this.callbacks.onChatMessage({\n          id: `sys_join_${msg.member.peerId}_${Date.now()}`,\n          kind: \'system\',\n          senderPeerId: \'system\',\n          senderName: \'System\',\n          text: `${msg.member.identity.deviceName} (${msg.member.role}) connected.`,\n          timestamp: Date.now(),\n        });\n        break;\n\n      case \'room:peer_left\':\n        this.closeWebRTCPeer(msg.peerId);\n        this.callbacks.onChatMessage({\n          id: `sys_left_${msg.peerId}_${Date.now()}`,\n          kind: \'system\',\n          senderPeerId: \'system\',\n          senderName: \'System\',\n          text: `${msg.deviceName} left the room (${msg.reason}).`,\n          timestamp: Date.now(),\n        });\n        break;\n\n      case \'room:closed\':\n        this.closeAllWebRTC();\n        this.currentRoom = null;\n        this.callbacks.onRoomUpdated(null);\n        this.callbacks.onRemoteTerminalState(null);\n        this.callbacks.onError(\'ROOM_CLOSED\', msg.reason);\n        break;\n\n      case \'room:invite_created\':\n        this.callbacks.onInviteCreated(msg.invite);\n        break;\n\n      case \'room:invite_revoked\':\n        this.callbacks.onInviteRevoked(msg.token);\n        break;\n\n      case \'signal:webrtc\':\n        await this.handleWebRTCSignal(msg.fromPeerId, msg.signalType, msg.payload);\n        break;\n\n      case \'relay:payload\':\n        await this.handleIncomingEnvelope(msg.fromPeerId, msg.envelope, \'relayed\');\n        break;\n\n      case \'error\':\n        this.callbacks.onError(msg.code, msg.message);\n        break;\n    }\n  }\n\n  private async initiateWebRTC(targetPeerId: string): Promise<void> {\n    if (typeof RTCPeerConnection === \'undefined\') return;\n    try {\n      const pc = this.createPeerConnection(targetPeerId);\n      const dc = pc.createDataChannel(\'termlink-p2p\', { ordered: true });\n      this.attachDataChannel(targetPeerId, dc);\n      const offer = await pc.createOffer();\n      await pc.setLocalDescription(offer);\n      this.sendSignal({\n        type: \'signal:webrtc\',\n        targetPeerId,\n        signalType: \'offer\',\n        payload: offer,\n      });\n    } catch {\n      this.peerModes.set(targetPeerId, \'relayed\');\n      this.callbacks.onPeerConnectionMode(targetPeerId, \'relayed\');\n    }\n  }\n\n  private createPeerConnection(remotePeerId: string): RTCPeerConnection {\n    const existing = this.rtcPeers.get(remotePeerId);\n    if (existing) existing.close();\n\n    const pc = new RTCPeerConnection({\n      iceServers: this.stunServers.map((urls) => ({ urls })),\n    });\n    this.rtcPeers.set(remotePeerId, pc);\n\n    pc.onicecandidate = (ev) => {\n      if (ev.candidate) {\n        this.sendSignal({\n          type: \'signal:webrtc\',\n          targetPeerId: remotePeerId,\n          signalType: \'ice-candidate\',\n          payload: ev.candidate,\n        });\n      }\n    };\n\n    pc.ondatachannel = (ev) => {\n      this.attachDataChannel(remotePeerId, ev.channel);\n    };\n\n    pc.onconnectionstatechange = () => {\n      if (pc.connectionState === \'connected\') {\n        this.peerModes.set(remotePeerId, \'direct_p2p\');\n        this.callbacks.onPeerConnectionMode(remotePeerId, \'direct_p2p\');\n        this.sendSignal({ type: \'room:report_connection\', targetPeerId: remotePeerId, mode: \'direct_p2p\' });\n      } else if (pc.connectionState === \'failed\' || pc.connectionState === \'disconnected\') {\n        this.peerModes.set(remotePeerId, \'relayed\');\n        this.callbacks.onPeerConnectionMode(remotePeerId, \'relayed\');\n        this.sendSignal({ type: \'room:report_connection\', targetPeerId: remotePeerId, mode: \'relayed\' });\n      }\n    };\n\n    return pc;\n  }\n\n  private attachDataChannel(remotePeerId: string, dc: RTCDataChannel): void {\n    this.dataChannels.set(remotePeerId, dc);\n    dc.onopen = () => {\n      this.peerModes.set(remotePeerId, \'direct_p2p\');\n      this.callbacks.onPeerConnectionMode(remotePeerId, \'direct_p2p\');\n      this.sendSignal({ type: \'room:report_connection\', targetPeerId: remotePeerId, mode: \'direct_p2p\' });\n    };\n    dc.onclose = () => {\n      this.dataChannels.delete(remotePeerId);\n      this.peerModes.set(remotePeerId, \'relayed\');\n      this.callbacks.onPeerConnectionMode(remotePeerId, \'relayed\');\n    };\n    dc.onmessage = (ev) => {\n      try {\n        const envelope = JSON.parse(String(ev.data)) as EncryptedEnvelope;\n        void this.handleIncomingEnvelope(remotePeerId, envelope, \'direct_p2p\');\n      } catch {\n        // ignore\n      }\n    };\n  }\n\n  private async handleWebRTCSignal(\n    fromPeerId: string,\n    signalType: string,\n    payload: unknown\n  ): Promise<void> {\n    if (typeof RTCPeerConnection === \'undefined\') return;\n    try {\n      if (signalType === \'offer\') {\n        const pc = this.createPeerConnection(fromPeerId);\n        await pc.setRemoteDescription(new RTCSessionDescription(payload as RTCSessionDescriptionInit));\n        const answer = await pc.createAnswer();\n        await pc.setLocalDescription(answer);\n        this.sendSignal({\n          type: \'signal:webrtc\',\n          targetPeerId: fromPeerId,\n          signalType: \'answer\',\n          payload: answer,\n        });\n      } else if (signalType === \'answer\') {\n        const pc = this.rtcPeers.get(fromPeerId);\n        if (pc) {\n          await pc.setRemoteDescription(new RTCSessionDescription(payload as RTCSessionDescriptionInit));\n        }\n      } else if (signalType === \'ice-candidate\') {\n        const pc = this.rtcPeers.get(fromPeerId);\n        if (pc) {\n          await pc.addIceCandidate(new RTCIceCandidate(payload as RTCIceCandidateInit));\n        }\n      }\n    } catch {\n      this.peerModes.set(fromPeerId, \'relayed\');\n      this.callbacks.onPeerConnectionMode(fromPeerId, \'relayed\');\n    }\n  }\n\n  private closeWebRTCPeer(peerId: string): void {\n    this.dataChannels.get(peerId)?.close();\n    this.dataChannels.delete(peerId);\n    this.rtcPeers.get(peerId)?.close();\n    this.rtcPeers.delete(peerId);\n    this.peerModes.delete(peerId);\n  }\n\n  private closeAllWebRTC(): void {\n    for (const pid of Array.from(this.rtcPeers.keys())) {\n      this.closeWebRTCPeer(pid);\n    }\n  }\n\n  private async sendPeerPayload(targetPeerId: string, payload: PeerDataPayload): Promise<ConnectionMode> {\n    const remoteIdentity = this.peerIdentities.get(targetPeerId);\n    if (!remoteIdentity) return \'disconnected\';\n\n    const envelope = await sealBrowserPayload(\n      this.identity,\n      this.peerId,\n      targetPeerId,\n      remoteIdentity.dhPublicKey,\n      payload\n    );\n\n    const dc = this.dataChannels.get(targetPeerId);\n    if (dc && dc.readyState === \'open\') {\n      dc.send(JSON.stringify(envelope));\n      return \'direct_p2p\';\n    }\n\n    this.sendSignal({\n      type: \'relay:payload\',\n      targetPeerId,\n      envelope,\n    });\n    this.peerModes.set(targetPeerId, \'relayed\');\n    return \'relayed\';\n  }\n\n  private async handleIncomingEnvelope(\n    fromPeerId: string,\n    envelope: EncryptedEnvelope,\n    mode: ConnectionMode\n  ): Promise<void> {\n    const remoteIdentity = this.peerIdentities.get(fromPeerId);\n    if (!remoteIdentity) return;\n\n    let payload: PeerDataPayload;\n    try {\n      payload = await openBrowserPayload<PeerDataPayload>(this.identity, remoteIdentity, envelope);\n    } catch {\n      return;\n    }\n\n    switch (payload.kind) {\n      case \'chat:group\':\n        this.callbacks.onChatMessage({\n          id: payload.messageId,\n          kind: \'group\',\n          senderPeerId: fromPeerId,\n          senderName: payload.senderName,\n          text: payload.text,\n          timestamp: payload.timestamp,\n          connectionMode: mode,\n        });\n        await this.sendPeerPayload(fromPeerId, {\n          kind: \'chat:ack\',\n          messageId: payload.messageId,\n          receivedAt: Date.now(),\n        });\n        break;\n\n      case \'chat:private\':\n        this.callbacks.onChatMessage({\n          id: payload.messageId,\n          kind: \'private\',\n          senderPeerId: fromPeerId,\n          senderName: payload.senderName,\n          toPeerName: this.identity.publicIdentity.deviceName,\n          text: payload.text,\n          timestamp: payload.timestamp,\n          connectionMode: mode,\n        });\n        await this.sendPeerPayload(fromPeerId, {\n          kind: \'chat:ack\',\n          messageId: payload.messageId,\n          receivedAt: Date.now(),\n        });\n        break;\n\n      case \'chat:ack\':\n        this.callbacks.onMessageDelivered(payload.messageId);\n        break;\n\n      case \'command:proposal\':\n        this.callbacks.onCommandProposal({\n          proposalId: payload.proposalId,\n          direction: \'incoming\',\n          peerId: fromPeerId,\n          peerName: payload.senderName,\n          command: payload.command,\n          description: payload.description,\n          timestamp: payload.timestamp,\n          status: \'pending\',\n        });\n        break;\n\n      case \'command:decision\':\n        this.callbacks.onCommandDecision(payload.proposalId, payload.decision, payload.editedCommand);\n        break;\n\n      case \'file:offer\':\n        this.pendingOffers.set(payload.transferId, {\n          fromPeerId,\n          senderName: payload.senderName,\n          filename: payload.filename,\n          size: payload.size,\n          sha256: payload.sha256,\n          totalChunks: payload.totalChunks,\n        });\n        this.callbacks.onFileTransferUpdate({\n          transferId: payload.transferId,\n          direction: \'receive\',\n          peerId: fromPeerId,\n          peerName: payload.senderName,\n          filename: payload.filename,\n          size: payload.size,\n          sha256: payload.sha256,\n          totalChunks: payload.totalChunks,\n          completedChunks: 0,\n          bytesTransferred: 0,\n          percent: 0,\n          speedBytesPerSec: 0,\n          etaSeconds: 0,\n          status: \'offering\',\n          startedAt: Date.now(),\n        });\n        break;\n\n      case \'file:response\': {\n        const out = this.outgoingFiles.get(payload.transferId);\n        if (!out) return;\n        if (!payload.accepted) {\n          out.item.status = \'rejected\';\n          out.item.error = payload.reason;\n          this.callbacks.onFileTransferUpdate({ ...out.item });\n          this.outgoingFiles.delete(payload.transferId);\n          return;\n        }\n        void this.streamOutgoingFile(out, payload.resumeFromChunk ?? 0);\n        break;\n      }\n\n      case \'file:chunk\': {\n        const inc = this.incomingFiles.get(payload.transferId);\n        if (!inc) return;\n        const bytes = base64ToUint8Array(payload.dataBase64);\n        const hash = await sha256Hex(bytes);\n        if (hash !== payload.sha256) {\n          inc.item.status = \'failed\';\n          inc.item.error = `Chunk ${payload.chunkIndex} checksum mismatch`;\n          this.callbacks.onFileTransferUpdate({ ...inc.item });\n          this.incomingFiles.delete(payload.transferId);\n          return;\n        }\n        inc.chunks.push(bytes);\n        inc.receivedCount += 1;\n        inc.bytesReceived += bytes.length;\n        const elapsed = Math.max(0.05, (Date.now() - inc.startedAt) / 1000);\n        const speed = inc.bytesReceived / elapsed;\n        inc.item.completedChunks = inc.receivedCount;\n        inc.item.bytesTransferred = inc.bytesReceived;\n        inc.item.percent = inc.item.size === 0 ? 100 : Math.min(100, Math.round((inc.bytesReceived / inc.item.size) * 100));\n        inc.item.speedBytesPerSec = speed;\n        inc.item.etaSeconds = speed > 0 ? Math.ceil(Math.max(0, inc.item.size - inc.bytesReceived) / speed) : 0;\n        this.callbacks.onFileTransferUpdate({ ...inc.item });\n\n        await this.sendPeerPayload(fromPeerId, {\n          kind: \'file:chunk_ack\',\n          transferId: payload.transferId,\n          chunkIndex: payload.chunkIndex,\n          ok: true,\n        });\n\n        if (inc.receivedCount >= inc.item.totalChunks) {\n          const totalLen = inc.chunks.reduce((sum, c) => sum + c.length, 0);\n          const merged = new Uint8Array(totalLen);\n          let offset = 0;\n          for (const c of inc.chunks) {\n            merged.set(c, offset);\n            offset += c.length;\n          }\n          const finalSha = await sha256Hex(merged);\n          const verified = finalSha === inc.item.sha256;\n          inc.item.verified = verified;\n          inc.item.status = verified ? \'completed\' : \'failed\';\n          if (verified) {\n            const blob = new Blob([merged]);\n            inc.item.downloadUrl = URL.createObjectURL(blob);\n          } else {\n            inc.item.error = \'Final SHA-256 verification failed\';\n          }\n          this.callbacks.onFileTransferUpdate({ ...inc.item });\n          this.incomingFiles.delete(payload.transferId);\n          await this.sendPeerPayload(fromPeerId, {\n            kind: \'file:complete\',\n            transferId: payload.transferId,\n            verified,\n            sha256: finalSha,\n            error: inc.item.error,\n          });\n        }\n        break;\n      }\n\n      case \'file:chunk_ack\': {\n        const out = this.outgoingFiles.get(payload.transferId);\n        if (!out) return;\n        const key = `${fromPeerId}:${payload.chunkIndex}`;\n        const r = out.ackWaiters.get(key);\n        if (r) {\n          out.ackWaiters.delete(key);\n          r();\n        }\n        break;\n      }\n\n      case \'file:control\': {\n        const inc = this.incomingFiles.get(payload.transferId);\n        if (inc) {\n          if (payload.action === \'cancel\') {\n            inc.item.status = \'cancelled\';\n            this.callbacks.onFileTransferUpdate({ ...inc.item });\n            this.incomingFiles.delete(payload.transferId);\n          } else if (payload.action === \'pause\') {\n            inc.item.status = \'paused\';\n            this.callbacks.onFileTransferUpdate({ ...inc.item });\n          } else if (payload.action === \'resume\') {\n            inc.item.status = \'transferring\';\n            this.callbacks.onFileTransferUpdate({ ...inc.item });\n          }\n        }\n        break;\n      }\n\n      case \'file:complete\': {\n        const out = this.outgoingFiles.get(payload.transferId);\n        if (out) {\n          out.item.verified = payload.verified;\n          out.item.status = payload.verified ? \'completed\' : \'failed\';\n          out.item.percent = payload.verified ? 100 : out.item.percent;\n          out.item.error = payload.error;\n          this.callbacks.onFileTransferUpdate({ ...out.item });\n          this.outgoingFiles.delete(payload.transferId);\n        }\n        break;\n      }\n\n      case \'terminal:state\':\n        this.callbacks.onRemoteTerminalState({\n          sessionId: payload.sessionId,\n          sessionName: payload.sessionName,\n          ownerPeerId: payload.ownerPeerId,\n          ownerName: payload.ownerName,\n          active: payload.active,\n          locked: payload.locked,\n          shell: payload.shell,\n          permissions: payload.permissions,\n        });\n        break;\n\n      case \'terminal:output\':\n        this.callbacks.onRemoteTerminalOutput(payload.data);\n        break;\n\n      case \'terminal:input\':\n        // Host forwards remote interactive terminal input through local host terminal API\n        if (this.currentRoom && this.currentRoom.ownerPeerId === this.peerId) {\n          const sender = this.currentRoom.members.find((m) => m.peerId === fromPeerId);\n          void fetch(`/api/terminal/${encodeURIComponent(this.currentRoom.roomId)}/input`, {\n            method: \'POST\',\n            headers: { \'Content-Type\': \'application/json\' },\n            body: JSON.stringify({\n              peerId: fromPeerId,\n              peerName: sender?.identity.deviceName ?? fromPeerId,\n              data: payload.data,\n            }),\n          });\n        }\n        break;\n    }\n  }\n\n  private async streamOutgoingFile(ctrl: OutgoingTransferControl, startChunk: number): Promise<void> {\n    ctrl.item.status = \'transferring\';\n    ctrl.item.startedAt = Date.now();\n    this.callbacks.onFileTransferUpdate({ ...ctrl.item });\n\n    for (let idx = startChunk; idx < ctrl.item.totalChunks; idx++) {\n      if (ctrl.paused) {\n        await new Promise<void>((resolve) => ctrl.resumeResolvers.push(resolve));\n      }\n      if (ctrl.cancelled) return;\n\n      const start = idx * BROWSER_CHUNK_SIZE;\n      const end = Math.min(ctrl.file.size, start + BROWSER_CHUNK_SIZE);\n      const sliceBuf = await ctrl.file.slice(start, end).arrayBuffer();\n      const chunkHash = await sha256Hex(sliceBuf);\n      const dataBase64 = arrayBufferToBase64(sliceBuf);\n\n      const ackKey = `${ctrl.item.peerId}:${idx}`;\n      const ackWait = new Promise<void>((resolve) => {\n        ctrl.ackWaiters.set(ackKey, resolve);\n        window.setTimeout(() => {\n          if (ctrl.ackWaiters.has(ackKey)) {\n            ctrl.ackWaiters.delete(ackKey);\n            resolve();\n          }\n        }, 12_000);\n      });\n\n      await this.sendPeerPayload(ctrl.item.peerId, {\n        kind: \'file:chunk\',\n        transferId: ctrl.item.transferId,\n        chunkIndex: idx,\n        totalChunks: ctrl.item.totalChunks,\n        sha256: chunkHash,\n        dataBase64,\n      });\n\n      await ackWait;\n\n      ctrl.item.completedChunks = idx + 1;\n      ctrl.item.bytesTransferred = end;\n      const elapsed = Math.max(0.05, (Date.now() - ctrl.item.startedAt) / 1000);\n      const speed = end / elapsed;\n      ctrl.item.speedBytesPerSec = speed;\n      ctrl.item.etaSeconds = speed > 0 ? Math.ceil(Math.max(0, ctrl.file.size - end) / speed) : 0;\n      ctrl.item.percent = ctrl.file.size === 0 ? 100 : Math.min(100, Math.round((end / ctrl.file.size) * 100));\n      this.callbacks.onFileTransferUpdate({ ...ctrl.item });\n    }\n  }\n}\n"
